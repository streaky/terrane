namespace layout-calls

function observed string; value string
    print; value
    return value

function combine string; first string, second string
    return first + ':' + second

function apply string; callback function to string
    return callback;

function one string; value string
    return value

function pick (function to string)|none; first string, second string
    print; first + second
    return none

function test-scenario;
    text = '  hello world  '
    result = text
        .trim;
        .replace;
            observed; 'world'
            replacement = observed; 'Terrane'
        .upper;
    print; result
    print; text
    print; (combine;
        observed; 'left'
        observed; 'right')
    print;
        combine;
            'nested'
            'calls'
    literal = 'unused'
        .replace;
            'unused'
            >>
                .not-a-call;
        .upper;
    print; literal
    print; (apply; (function string;
        return 'r'))
    print; (apply; function string;
        return 'r')
    print;
        apply;
            function string;
                return 'r'
    wrapped = (combine; 'a' +
        'b', 'c')
    print; wrapped
    print; (combine; 'a'
        , 'b')
    wrapped-one = (one; 'a' +
        'b')
    print; wrapped-one
    picked (function to string)|none = (pick;
        'a'
        'b')
    print; picked is a none
