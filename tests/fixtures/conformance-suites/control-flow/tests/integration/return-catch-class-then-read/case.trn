namespace return-catch-class-then-read
from /core/collections import list
from /core/errors import throwable

class Err implements throwable
    message string = 'x'
    function render string;
        return this.message

function bad int;
    throw instance Err;

class K
    n int = 4

function eatk K; x K
    print; (bad;)
    return x

function f K; o K
    try
        return (eatk; o)
    catch
        print; 0
    return o

function test-scenario;
    print; (f; (instance K;)).n
