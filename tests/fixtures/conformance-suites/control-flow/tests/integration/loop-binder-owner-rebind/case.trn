namespace loop-binder-owner-rebind
from /core/collections import list

function shared-shared;
    values = list; 1
    for value in ref values
        print; value
    values = list; 2, 3
    for value in ref values
        print; value
    print; values.length

function shared-exclusive;
    values = list; 1
    for value in ref values
        print; value
    values = list; 2, 3
    for value in mutable ref values
        print; value
    print; values.length

function exclusive-shared;
    values = list; 1
    for value in mutable ref values
        print; value
    values = list; 2, 3
    for value in ref values
        print; value
    print; values.length

function exclusive-exclusive;
    values = list; 1
    for value in mutable ref values
        print; value
    values = list; 2, 3
    for value in mutable ref values
        print; value
    print; values.length

function test-scenario;
    shared-shared;
    shared-exclusive;
    exclusive-shared;
    exclusive-exclusive;
