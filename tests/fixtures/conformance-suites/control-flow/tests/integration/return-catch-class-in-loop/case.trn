namespace return-catch-class-in-loop
from /core/collections import list
from /core/errors import throwable

class Err implements throwable
    message string = 'x'
    function render string;
        return this.message

function bad int;
    throw instance Err;

class K
    n int = 4

function eatk K; x K
    print; (bad;)
    return x

function f K; o K
    for i in (list; 1, 2)
        try
            return (eatk; o)
        catch
            print; i
    return o

function test-scenario;
    print; (f; (instance K;)).n
