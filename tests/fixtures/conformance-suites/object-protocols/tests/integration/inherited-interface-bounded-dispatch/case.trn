namespace inherited-interface-bounded-dispatch
from /core/collections import list
interface base
    function read int;
    mutable function increment int;
    consuming function finish int;
interface sub implements base
    function extra int;
class Item implements sub
    value int = 1
    function read int;
        return this.value
    mutable function increment int;
        this.value = this.value + 1
        return this.value
    consuming function finish int;
        return this.value
    function extra int;
        return 9
function forward of (T implements base) int; value T
    return value.read;
function inspect of (T implements sub) int; values list of T
    return values[0].read;
function mutate of (T implements sub) int; item mutable ref T
    return item.increment;
function consume of (T implements sub) int; item T
    return item.finish;
function test-scenario;
    values list of Item = list; (instance Item;)
    print; (inspect; values)
    item = instance Item;
    print; (mutate; item)
    print; (forward; item)
    print; (consume; move item)
