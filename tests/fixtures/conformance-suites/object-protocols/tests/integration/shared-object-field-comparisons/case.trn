namespace shared-object-field-comparisons
from /core/time import duration

class holder
    a duration = duration::seconds; 1
    b duration = duration::seconds; 2

class inherited-holder extends holder

class required-holder
    a duration
    b duration
    function construct; a duration, b duration
        this.a = move a
        this.b = move b

function replace duration; owner shared ref holder
    owner.a = duration::seconds; 2
    return owner.a

function test-scenario;
    h = shared ref (instance holder;)
    other = duration::seconds; 1
    print; h.a == other
    print; other == h.a
    print; h.a < h.b
    print; h.b > h.a
    alias = h
    print; h.a <= alias.b
    observer = ref h
    print; observer.a < h.b
    print; h.a < (replace; alias)
    print; h.a == h.b
    ordinary = instance holder;
    print; ordinary.a < ordinary.b
    print; ordinary.a.seconds
    inherited = shared ref (instance inherited-holder;)
    print; inherited.a < inherited.b
    initialized = shared ref (instance required-holder; (duration::seconds; 1), (duration::seconds; 2))
    print; initialized.a < initialized.b
