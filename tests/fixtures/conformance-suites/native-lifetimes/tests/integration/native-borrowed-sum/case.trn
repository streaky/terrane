namespace native-borrowed-sum
from /deps/terrane-query-witness import Records, MetadataText, PointRecords
from /core/errors import dependency-panic

function lookup MetadataText|none; records ref Records, mode int, index int
    ordinal = index.coerce.checked; uint64
    if ordinal != none
        return ((records.parameters; mode).select_left;).get_cloned; ordinal
    return none

function point-x int; points ref PointRecords
    selected = ((points.points;).select_text_value;).get_cloned; 0
    if selected != none
        return selected.x
    return 0

function test-scenario;
    records = Records::new; true
    found = lookup; records, 1, 1
    if found != none
        print; (found.contents;)
    print; (lookup; records, 0, 1) == none
    print; (lookup; records, 2, 1) == none
    print; (lookup; records, 1, 3) == none
    print; (lookup; records, 1, -1) == none
    print; (MetadataText::copies;)
    points = PointRecords::new;
    print; (point-x; points)
    try
        found-before-panic MetadataText|none = ((records.parameters; 9).select_left;).get_cloned; 0
        print; found-before-panic == none
    catch dependency-panic as error
        print; (error.message.contains; 'terrane-query-witness') and (error.message.contains; 'terrane_query_witness::Records::parameters') and (error.message.contains; 'parameters panic')
    print; (((points.collision; 1).select_http_value;).get_cloned; 0) != none
    print; (((points.collision; 2).select_http_value_variant4;).get_cloned; 0) != none
    print; (((points.collision; 3).select_http_value_variant3;).get_cloned; 0) != none
