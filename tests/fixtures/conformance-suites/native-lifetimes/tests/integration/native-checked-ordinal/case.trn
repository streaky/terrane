namespace native-checked-ordinal
from /deps/terrane-query-witness import OrdinalRow
from /core/errors import integer-conversion-overflow, throwable

function cell-size int; row ref OrdinalRow, index int
    return (row.cell; index).size;

function test-scenario;
    row = OrdinalRow::sample;
    print; (cell-size; row, 1)
    try
        print; (cell-size; row, -1)
    catch integer-conversion-overflow
        print; 'index overflow'
    try
        print; (cell-size; row, 2)
    catch throwable
        print; 'missing cell'
