namespace native-borrowed-iterator
from /deps/terrane-query-witness import Records, MetadataText

function nonempty string|none; value ref MetadataText
    text = value.searched_contents;
    if text == ''
        return none
    return text

function first-text string|none; records shared ref Records
    return ((records.values;).iter;).find_map; nonempty

function first-text-borrowed string|none; records ref Records
    return ((records.values;).iter;).find_map; nonempty

function first-text-owned string|none;
    records = Records::new; true
    return ((records.values;).iter;).find_map; nonempty

function collected-text list of string; records ref Records
    return ((records.values;).iter;).filter_map_collect; nonempty-entry

function mapped-text list of string;
    records = Records::new; true
    return ((records.values;).iter;).map_collect; entry-text

function entry-text string; entry ref MetadataText
    return entry.contents;

function nonempty-entry string|none; entry ref MetadataText
    text = entry.contents;
    if text == ''
        return none
    return move text

function add-pair uint64; total uint64, first ref MetadataText, second ref MetadataText
    first-length uint64 = (first.contents;).bytes.length
    second-length uint64 = (second.contents;).bytes.length
    base = total.multiply.saturate; 10
    partial = base.add.saturate; first-length
    return partial.add.saturate; second-length

function pair-score uint64; records shared ref Records
    seed uint64 = 0
    return (records.pairs;).fold; seed, add-pair

function fold-value uint64; total uint64, value ref MetadataText
    length uint64 = (value.contents;).bytes.length
    return total.add.saturate; length

function value-score uint64; records ref Records
    seed uint64 = 0
    return ((records.values;).iter;).fold; seed, fold-value

function test-scenario;
    records = shared ref (Records::new; true)
    found = first-text; records
    if found != none
        print; found
    missing = shared ref (Records::new; false)
    print; (first-text; missing) == none
    plain = Records::new; true
    borrowed = first-text-borrowed; plain
    if borrowed != none
        print; borrowed
    owned = first-text-owned;
    if owned != none
        print; owned
    view = plain.values;
    bound string|none = (view.iter;).find_map; nonempty
    if bound != none
        print; bound
    print; (value-score; plain)
    for text in (collected-text; plain)
        print; text
    empty = Records::new; false
    print; (collected-text; empty).length
    for text in (mapped-text;)
        print; '[' + text + ']'
    print; (MetadataText::copies;)
    print; (pair-score; records)
