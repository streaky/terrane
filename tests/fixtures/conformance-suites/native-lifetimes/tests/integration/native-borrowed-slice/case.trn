namespace native-borrowed-slice
from /deps/terrane-query-witness import SliceCatalog, SliceEntry

function title string; entry ref SliceEntry
    return entry.title;

function titles list of string; catalog ref SliceCatalog
    return (catalog.entries;).map_collect; title

function test-scenario;
    catalog = SliceCatalog::sample;
    for name in (titles; catalog)
        print; name
