namespace native-inferred-copy-view
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import list
function mutable_size int; value mutable ref CopyView
    return value.size;

function readonly_size int; value ref CopyView
    return value.size;

function test-scenario;
    holder = Holder::new;
    inferred_view = holder.copy_view;
    print; (mutable_size; inferred_view)
    print; (readonly_size; inferred_view)
    inferred = list; (holder.copy_view;)
    print; (inferred[0].size;)
    print; (inferred[0].size;)
    typed list of CopyView = list; (holder.copy_view;)
    print; (typed[0].size;)
