namespace native-copy-view-reassignment-snapshot
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import list

function fresh CopyView; lender ref Holder
    print; 'fresh'
    return lender.copy_view;

function test-scenario;
    h = Holder::new;
    k = Holder::new;
    c = h.copy_view;
    values = list; c
    c = k.copy_view;
    k.bump;
    print; (values[0].size;)
    c = fresh; k
    print; (c.size;)
    k.bump;
    print; (values[0].size;)
