namespace native-view-map-entry-iteration
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import map, unordered-map

function test-scenario;
    holder = Holder::new;
    ordered map of string, CopyView = map;
    ordered.set; 'ordered', (holder.copy_view;)
    for key, value in ordered
        print; (value.size;)

    unordered unordered-map of string, CopyView = unordered-map;
    unordered.set; 'unordered', (holder.copy_view;)
    for key, value in unordered
        print; (value.size;)

    ordered-inner map of string, CopyView = map;
    ordered-inner.set; 'nested', (holder.copy_view;)
    ordered-outer map of string, (map of string, CopyView) = map;
    ordered-outer.set; 'outer', ordered-inner
    for outer-key, inner in ordered-outer
        for inner-key, value in inner
            print; (value.size;)

    unordered-inner unordered-map of string, CopyView = unordered-map;
    unordered-inner.set; 'nested', (holder.copy_view;)
    unordered-outer unordered-map of string, (unordered-map of string, CopyView) = unordered-map;
    unordered-outer.set; 'outer', unordered-inner
    for outer-key, inner in unordered-outer
        for inner-key, value in inner
            print; (value.size;)

    for key, value in ordered
        print; (value.size;)
        ordered.set; 'later', (holder.copy_view;)
    print; ordered.length
