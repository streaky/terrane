namespace native-loan-helper-view-origin
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import list

function pick CopyView; value CopyView
    return value

function wrap list of CopyView; value CopyView
    return list; value

function identity list of CopyView; values list of CopyView
    return values

function test-scenario;
    h = Holder::new;
    view = pick; (h.copy_view;)
    print; (view.size;)
    values = identity; (wrap; (h.copy_view;))
    print; (values[0].size;)
    h.bump;
