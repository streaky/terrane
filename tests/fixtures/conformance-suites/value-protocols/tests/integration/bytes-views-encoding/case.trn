namespace bytes-views-encoding
from /core/errors import decode-error

constant title string = 'héllo'
constant sample-bytes bytes = b'h\xc3\xa9llo'

function test-scenario;
  text string = 'é'
  print; text.length, text.bytes.length, text.scalars.length, text.graphemes.length
  byte-count = 0
  for byte in text.bytes
    if byte == byte
      byte-count = byte-count + 1
  scalar-count = 0
  for scalar in text.scalars
    if scalar == scalar
      scalar-count = scalar-count + 1
  grapheme-count = 0
  for grapheme in text.graphemes
    if grapheme == grapheme
      grapheme-count = grapheme-count + 1
  print; byte-count, scalar-count, grapheme-count
  encoded bytes = text.encode; utf8
  decoded string = encoded.decode; utf8
  print; decoded
  utf16le-text string = (text.encode; utf16-le).decode; utf16-le
  utf16be-text string = (text.encode; utf16-be).decode; utf16-be
  utf32le-text string = (text.encode; utf32-le).decode; utf32-le
  utf32be-text string = (text.encode; utf32-be).decode; utf32-be
  print; utf16le-text
  print; utf16be-text
  print; utf32le-text
  print; utf32be-text
  owned bytes = text.encode; utf8
  print; ((move owned).decode; utf8)
  wide bytes = text.encode; utf16-le
  print; ((move wide).decode; utf16-le)
  invalid bytes = b'a\xff'
  try
    print; ((move invalid).decode; utf8)
  catch decode-error as error
    print; error.message
  print; title.bytes.length
  print; title.scalars.length
  print; title.graphemes.length
  namespace-byte-count = 0
  for byte in title.bytes
    if byte == byte
      namespace-byte-count = namespace-byte-count + 1
  print; namespace-byte-count
  print; sample-bytes[1]
  print; (sample-bytes.decode; utf8)
  print; (title.encode; utf8).length
