namespace bounded-local-shared-list
from /core/collections import list
interface named
    function name int;

class value implements named
    amount int = 1
    function name int;
        return this.amount

function go of (T implements named) int; item T
    fs list of function to int = list;
    fs.append; function int;
        return item.name;
    return fs.length

function test-scenario;
    print; (go; (instance value;))
