namespace bounded-list-capture
from /core/collections import list
interface named
    function name int;

class value implements named
    amount int = 1
    function name int;
        return this.amount

function go of (T implements named) int; items list of T
    f = function int;
        return items.length
    return f;

function test-scenario;
    print; (go; (list; (instance value;)))
