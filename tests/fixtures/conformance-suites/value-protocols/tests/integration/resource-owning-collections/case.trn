namespace resource-owning-collections
from /core/collections import list, map, unordered-map
from /core/errors import index-error, missing-key
from /core/streams import byte-writer, stdout

class marker
  output byte-writer = stdout;
  name string
  function construct; name string
    this.name = name
  consuming function destruct;
    print; 'drop-', this.name

class bucket
  items list of marker = list

function seed list of marker;
  item = instance marker; 'first'
  return list; item

function inspect; item ref marker
  print; 'see-', item.name

function release; item marker
  inspect; item

function test-scenario;
  owner = instance bucket;
  print; owner.items.length
  items list of marker = seed;
  next = instance marker; 'second'
  items.append; next
  items[1] = instance marker; 'third'
  for item in ref items
    inspect; item
  inspect; items[0]
  try
    items.remove; 5
  catch index-error
    print; 'bad-index'
  release; (items.remove; 0)
  items.clear;
  print; 'list-size-', items.length

  ordered map of string, marker = map; a=(instance marker; 'a')
  ordered.set; 'b', (instance marker; 'b')
  ordered['b'] = instance marker; 'replacement'
  inspect; ordered['b']
  absent = ordered.remove.checked; 'absent'
  print; absent == none
  for key in ordered.keys;
    print; 'key-', key
  ordered.remove; 'b'
  try
    ordered.remove; 'absent'
  catch missing-key
    print; 'bad-key'
  print; 'map-size-', ordered.length

  unordered unordered-map of string, marker = unordered-map
  unordered.set; 'x', (instance marker; 'x')
  unordered.set; 'y', (instance marker; 'y')
  unordered.remove.checked; 'x'
  unordered['z'] = instance marker; 'z'
  inspect; unordered['y']
  unordered.remove; 'y'
  unordered.remove; 'z'
  print; 'unordered-size-', unordered.length
