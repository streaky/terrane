namespace typed-serialization-boundaries

from /core/documents import document-encodable
from /core/documents/json import encode-typed-json, decode-typed-json, default-json-options, json-options, parse-json, stringify-json
from /core/collections import list

class child implements document-encodable
    value string = ''

class record implements document-encodable
    children list of child = list; (instance child;)
    name string = '' metadata (external-name = 'marker-like')

function test-boundaries;
    nested = instance child;
    nested.value = 'x'
    value = instance record;
    value.children = list; nested
    value.name = 'user-data'
    normal = encode-typed-json; value, (default-json-options;)
    print; normal.failed, '|', normal.value
    shallow = encode-typed-json; value, (instance json-options; 1, 1024)
    print; shallow.failed
    tiny = encode-typed-json; value, (instance json-options; 8, 1)
    print; tiny.failed
    marker = parse-json; '{"$serde_json::private::Number":"ordinary","value":123456789012345678901234567890}', (default-json-options;)
    print; marker.failed, '|', marker.value.encoded
    oversized = parse-json; '1e100001', (default-json-options;)
    print; oversized.failed
    rendered = stringify-json; marker.value, (instance json-options; 8, 8)
    print; rendered.failed
    scientific = decode-typed-json; '1e+3', int, (default-json-options;), false
    print; scientific.failed, '|', scientific.value
    expanded = decode-typed-json; '1e100000', int, (default-json-options;), false
    print; expanded.failed
    rounded = decode-typed-json; '1.000000059604644775390625000000000001', float32, (default-json-options;), false
    print; rounded.failed, '|', rounded.value > 1.0
    underflow = decode-typed-json; '1e-100000', float32, (default-json-options;), false
    print; underflow.failed, '|', underflow.value == 0.0
    nonfinite float64 = rust
        f64::INFINITY
    rejected = encode-typed-json; nonfinite, (default-json-options;)
    print; rejected.failed
