namespace throwable-function-value
from /core/errors import coercion-error

function render string throws coercion-error; value int
  if value < 0
    throw coercion-error
  return 'ok'

function apply string; operation function from int to string throws coercion-error, value int
  return operation; value

function main;
  operation function from int to string throws coercion-error = render
  print; operation.contracts
  print; operation.throwable-contract
  print; operation.escaping-throwables
  try
    print; (apply; operation, -1)
  catch coercion-error
    print; 'caught'
  print; (apply; operation, 4)
