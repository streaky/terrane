namespace app

from /deps/terrane-callable-recipe-witness import accept, accepts_handler as accepts-handler, blank, compose, install, invoke, mutate, render, run_correlated as run-correlated, transform
from /deps/terrane-callable-recipe-witness import MethodRouter
from /deps/terrane-callable-recipe-witness import registered, registration_value as registration-value, registration_value_with_state as registration-value-with-state

function produce int;
    return 42

function length int; value string
    return value.length

async function produce-async int;
    return 42

async function produce-async-one-argument int; value int
    return value + 1

function initial string;
    return 'value'

function initial-message int;
    return 7

function combine string; state string, message int
    return state

function no-argument int;
    return 0

function one-argument int; value int
    return value

function view-value int; state ref int
    return state + 0

async function main;
    print; (invoke; produce)
    print; (transform; 'one', length)
    print; (mutate; 'two', length)
    print; (install; produce-async)
    print; (run-correlated; initial, 7, combine)
    print; (compose; initial, initial-message, combine)
    print; (accepts-handler; no-argument)
    print; (accepts-handler; one-argument)
    print; (render; 4, view-value)
    print; (accept; (blank;))
    router MethodRouter = MethodRouter::new;
    print; (await router.dispatch; produce-async)
    router MethodRouter = MethodRouter::new;
    print; (await router.dispatch; produce-async-one-argument)
    print; (registration-value; (await registered; produce-async-one-argument))
    print; (registration-value-with-state; (await registered; produce-async-one-argument))
