namespace app

from /core/networking import ip-address-from-string, socket-address-from-ip
from /core/networking import tcp-listener, listener-result, stream-result, bind-tcp
from /core/io import io-operation-options
from /core/time import clock, duration

async function main;
    loopback = ip-address-from-string; '127.0.0.1'
    bind-address = socket-address-from-ip; loopback.value, 0
    bound listener-result = bind-tcp; bind-address.value
    listener tcp-listener = move bound.value

    expired-options = instance io-operation-options; (clock::deadline; (duration::nanoseconds; 0))
    expired stream-result = await listener.accept; expired-options
    print; expired.failed
    print; expired.deadline-exceeded
    listener.close;
