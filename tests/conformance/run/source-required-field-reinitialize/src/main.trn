namespace app
from /deps/terrane-borrowed-future-witness import Builder
class holder
    value Builder
    function construct; value Builder
        this.value = move value
async function main;
    h = instance holder; (Builder::new;)
    first = move h.value
    replacement = Builder::new;
    replacement.set; 3
    h.value = move replacement
    print; (await first.serve;), (await h.value.serve;)
