namespace app

from /core/output import print
from /standard/networking import ip-address-from-string, socket-address, host-name, operation-options, lookup-dns

function main;
    parsed = ip-address-from-string; '2001:0db8:0:0:0:0:0:1'
    print; parsed.value.value
    print; parsed.value.version
    port int = 443
    deadline int = 1000
    cancelled = operation-options; deadline, true
    lookup = lookup-dns; (host-name; 'localhost'), port, cancelled
    print; lookup.failed
    print; lookup.message
