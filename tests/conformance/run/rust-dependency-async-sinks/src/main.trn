namespace app
from /deps/terrane-sink-witness import duplex, drain_slowly, remotely_closed_sink, blocked_sink, queue_sink, Outgoing, Incoming
from /core/output import print

async function consume int; incoming Incoming
  return await drain_slowly; incoming

async function send-blocked async-sink-outcome; sink Outgoing
  return await sink.send; 'blocked'

async function main;
  whole = duplex; 1
  halves = whole.split;
  incoming = halves.take_incoming;
  outgoing = halves.take_outgoing;
  scope = task-scope;
  consumer = scope.spawn; (consume; incoming)
  first = await outgoing.send; 'one'
  second = await outgoing.send; 'two'
  print; first.accepted, first.closed, second.accepted
  flushed = await outgoing.flush;
  closed = await outgoing.close;
  print; flushed == closed
  consumed = await scope.join; consumer
  print; consumed.completed, consumed.value == none
  remote = remotely_closed_sink;
  rejected = await remote.send; 'lost'
  print; rejected.accepted, rejected.closed
  remote-closed = await remote.close;
  print; remote-closed == remote-closed
  blocked = blocked_sink;
  blocked-scope = task-scope;
  blocked-child = blocked-scope.spawn; (send-blocked; blocked)
  blocked-scope.cancel;
  cancelled = await blocked-scope.join; blocked-child
  print; cancelled.cancelled
  queue = queue_sink;
  queued = await queue.send; 'different'
  print; queued.accepted, queued.closed
  queue-flushed = queue.flush;
  queue-closed = queue.close;
  print; queue-flushed == queue-closed
