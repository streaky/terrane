namespace application-lowering-regressions

from /core/encodings import utf8

async function observe int; value int
  return value

function inspect-bytes; data bytes
  print; data.length

function branch-name string; left bool
  if left
    selected string = 'left'
    return selected
  selected string = 'right'
  return selected

async function main;
  await observe; 42
  data bytes = b'abc'
  inspect-bytes; data
  print; data.length
  print; (branch-name; true), (branch-name; false)
  for part in ('red,green'.split; ',')
    print; part
  counter int = 0
  while counter < 2
    print; counter
    counter = counter + 1
  print; (data.decode; utf8)
