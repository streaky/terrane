namespace app

from /deps/witness import Overridden, Wrapped, Mutator, panic_free, panic_generic
from /core/errors import throwable
from /deps/custom-lib-panic-witness import Panicker as CustomPanicker, fail_free as custom-fail-free

function update-twice uint8; mutator mutable ref Mutator
    print; (mutator.update; 2)
    print; (mutator.update; 3)
    return mutator.value;

function generic-panic-attributed bool; value Wrapped of uint8
    try
        wide uint32 = value.selected;
        return wide == 0
    catch throwable as error
        return (error.message.contains; 'Rust dependency `native-default-witness`') and (error.message.contains; 'member `witness::Wrapped::selected`') and (error.message.contains; 'generic selector panic')

function free-panic-attributed bool;
    try
        panic_free;
        return false
    catch throwable as error
        return (error.message.contains; 'Rust dependency `native-default-witness`') and (error.message.contains; 'member `witness::panic_free`') and (error.message.contains; 'free function panic')

function generic-free-panic-attributed bool;
    try
        payload uint8 = 9
        (panic_generic of uint8); payload
        return false
    catch throwable as error
        return (error.message.contains; 'Rust dependency `native-default-witness`') and (error.message.contains; 'member `witness::panic_generic`') and (error.message.contains; 'generic free function panic')

function custom-free-panic-attributed bool;
    try
        custom-fail-free;
        return false
    catch throwable as error
        return (error.message.contains; 'Rust dependency `custom-lib-panic-witness`') and (error.message.contains; '::fail_free`') and (error.message.contains; 'custom library free panic')

function custom-method-panic-attributed bool;
    value = CustomPanicker::new;
    try
        value.fail;
        return false
    catch throwable as error
        return (error.message.contains; 'Rust dependency `custom-lib-panic-witness`') and (error.message.contains; '::Panicker::fail`') and (error.message.contains; 'custom library instance panic')

async function custom-async-panic-attributed bool;
    value = CustomPanicker::new;
    try
        await value.fail_async;
        return false
    catch throwable as error
        return (error.message.contains; 'Rust dependency `custom-lib-panic-witness`') and (error.message.contains; '::Panicker::fail_async`') and (error.message.contains; 'custom library async panic')

async function main;
    seed uint8 = 9
    value Wrapped of uint8 = instance Wrapped; seed
    owner uint8 = value.owner_value;
    selected uint16 = value.selected;
    print; '' + owner + ':' + selected + ':' + (value.label;)

    overridden = Overridden::new;
    explicit-owner uint8 = overridden.owner_value;
    explicit-selected uint16 = overridden.selected;
    print; '' + explicit-owner + ':' + explicit-selected + ':' + (overridden.label;)

    mutator = Mutator::new; 10
    print; (update-twice; mutator)
    try
        mutator.update; 0
    catch throwable as error
        print; 'native error caught: ' + (error.message.contains; 'zero update rejected')
