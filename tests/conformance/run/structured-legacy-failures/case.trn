namespace structured-legacy-failures
from /core/errors import integer-conversion-overflow, division-by-zero
function narrow-fixed int8;
  wide int16 = 300
  return wide
function narrow-float float32;
  wide-float float64 = 340282400000000000000000000000000000000.0
  return wide-float
function divide int;
  numerator int = 1
  denominator int = 0
  return numerator / denominator
function remainder int;
  numerator int = 1
  denominator int = 0
  return numerator % denominator
function round-value int;
  one float64 = 1.0
  zero float64 = 0.0
  infinite float64 = one / zero
  return infinite.round;
function accepts-narrow int; value int8
  return value
function narrow-argument int;
  wide int16 = 300
  return accepts-narrow; wide
function main;
  try
    print; (narrow-fixed;)
  catch integer-conversion-overflow
    print; >fixed conversion caught
  try
    print; (narrow-float;)
  catch integer-conversion-overflow
    print; >float narrowing caught
  try
    print; (divide;)
  catch division-by-zero
    print; >int division caught
  try
    print; (remainder;)
  catch division-by-zero
    print; >int remainder caught
  try
    print; (round-value;)
  catch integer-conversion-overflow
    print; >rounding caught
  try
    print; (narrow-argument;)
  catch integer-conversion-overflow
    print; >argument conversion caught
  print; >after
