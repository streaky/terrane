namespace app

from /deps/terrane-associated-witness import Sequence as sequence, NamedSequence as named-sequence, Nested as nested, sequence_total as sequence-total, nested_total as nested-total, named_total as named-total, erased_total as erased-total
from /core/collections import list

class ints implements sequence of int
    value int = 40

    function first int|none;
        return this.value

    function length int;
        return 2

class nested-values implements sequence of nested
    function first nested|none;
        return none

    function length int;
        return 1

class named-ints implements named-sequence of int
    value int = 30

    function first int|none;
        return this.value

    function length int;
        return 4

    function label string;
        return 'name'

function interface-length int; value sequence of int
    return value.length;

function main;
    print; (sequence-total; (instance ints;))
    print; (nested-total; (instance nested-values;))
    print; (named-total; (instance named-ints;))
    print; (erased-total; (instance ints;))
    print; (erased-total; (instance named-ints;))
    applied sequence of int = instance ints;
    print; (erased-total; applied)
    applied-named named-sequence of int = instance named-ints;
    print; (erased-total; applied-named)
    print; (interface-length; (instance ints;))
    print; (interface-length; (instance named-ints;))
    applied-items list of sequence of int = list; (instance ints;)
    print; applied-items.length
    maybe-applied (sequence of int)|none = instance ints;
    print; maybe-applied != none
