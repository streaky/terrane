namespace app
from /deps/terrane-chain-witness import memory_database, query_scalar, line

async function main;
  database = await memory_database;
  answer int = await ((query_scalar; database, 'select ?1').bind; 42).fetch_one;
  prefix string = 'value='
  rendered string = ((line; prefix).number; answer).finish;
  print; answer
  print; rendered
