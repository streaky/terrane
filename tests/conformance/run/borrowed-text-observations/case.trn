namespace borrowed-text-observations

from /core/collections import list
from /core/encodings import utf8

class holder
    text string = ' AéA '
    data bytes = b'ABC'

function decode-input string; source ref bytes
    return source.decode; utf8

function scan-input int; source ref string
    total int = 0
    for byte in source.bytes
        if byte == 65
            total++
    return total

async function pause;
    return

async function scan-later int; source ref string
    total int = 0
    for byte in source.bytes
        await pause;
        if byte == 65
            total++
    return total

async function main;
    item = instance holder;
    print; (item.text.trim;)
    print; (decode-input; item.data)
    print; (scan-input; item.text)
    copy = item
    item.text = 'changed'
    print; copy.text
    print; item.text
    values list of string = list; ' nested '
    print; (values[0].trim;)
    source = 'AéA'
    for scalar in source.scalars
        print; scalar
    for grapheme in source.graphemes
        print; grapheme
    for byte in source.bytes
        print; byte
    source = 'ab'
    for scalar in source.scalars
        source = 'changed during traversal'
        print; scalar
    print; source
    for scalar in ('temporary'.upper;).scalars
        print; scalar
        break
    shared = shared ref (instance holder;)
    print; (shared.text.trim;)
    print; (shared.text.contains; shared.text)
    print; (shared.data.decode; utf8)
    maybe string|none = ' optional '
    if maybe != none
        print; (maybe.trim;)
    print; await scan-later; copy.text
