namespace app

from /deps/terrane-payload-enum-witness import Event, NonClonePayload, OpenEvent, OwnedEvent, consume_payload, future_event, non_clone_payload
from /core/output import print

function main;
  text = Event::Text; 'hello'
  print; (text.variant-name;)
  text-value string|none = text.into-Text;
  if text-value != none
    print; text-value
  binary = Event::Binary; b'AB'
  print; (binary.variant-name;)
  binary-value bytes|none = binary.into-Binary;
  if binary-value != none
    print; binary-value.length
  ping = Event::Ping;
  print; (ping.variant-name;)
  owned OwnedEvent|none = OwnedEvent::Payload; (non_clone_payload; 'owned')
  if owned != none
    payload NonClonePayload|none = (move owned).into-Payload;
    if payload != none
      print; (consume_payload; move payload)
  future OpenEvent = future_event;
  print; (future.variant-name;)
