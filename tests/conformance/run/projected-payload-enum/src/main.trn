namespace app

from /deps/terrane-payload-enum-witness import Event, Event-Named, Event-Optional, Event-Pair, NonClonePayload, OpenEvent, OwnedEvent, consume_payload, future_event, non_clone_payload
from /core/output import print

function main;
  text = Event::Text; 'hello'
  print; (text.variant-name;)
  text-value string|none = text.into-Text;
  if text-value != none
    print; text-value
  binary = Event::Binary; b'AB'
  print; (binary.variant-name;)
  binary-value bytes|none = binary.into-Binary;
  if binary-value != none
    print; binary-value.length
  ping = Event::Ping;
  print; (ping.variant-name;)
  pair-payload Event-Pair = instance Event-Pair; item-n0 = 20, item-n1 = 22
  print; pair-payload.item-n0 + pair-payload.item-n1
  pair Event = Event::Pair; pair-payload
  pair-value Event-Pair|none = pair.into-Pair;
  if pair-value != none
    print; 'pair'
  named-payload Event-Named = instance Event-Named; value = 42
  print; named-payload.value
  named Event = Event::Named; named-payload
  named-value Event-Named|none = named.into-Named;
  if named-value != none
    print; 'named'
  optional-payload Event-Optional = instance Event-Optional; value = 42, label = 'ok'
  optional Event = Event::Optional; optional-payload
  optional-value Event-Optional|none = optional.into-Optional;
  if optional-value != none
    print; 'optional'
  owned OwnedEvent|none = OwnedEvent::Payload; (non_clone_payload; 'owned')
  if owned != none
    payload NonClonePayload|none = (move owned).into-Payload;
    if payload != none
      print; (consume_payload; move payload)
  future OpenEvent = future_event;
  print; (future.variant-name;)
