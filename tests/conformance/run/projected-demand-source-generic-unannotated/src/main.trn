namespace app

from /deps/terrane-query-witness import Holder

class Box of (T)
  value T
  function construct; value T
    this.value = move value
  consuming function take T;
    return move this.value

function main;
  box = instance (Box of Holder); (Holder::new;)
  value = box.take;
  print; (value.label_len;)
