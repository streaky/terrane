namespace app

from /deps/terrane-query-witness import ConnectionOptions, insert_sql, operation_len, query

function lend ref string; sql ref string
  return sql

async function async_sql string;
  return insert_sql;

async function main;
  options = ConnectionOptions::new;
  connection = await options.connect;
  print; (operation_len; (await async_sql;))
  sql = await async_sql;
  computed = sql + ''
  result = await ((query; computed).bind; b'ok').execute; connection
  print; (result.rows_affected;)
  borrowed_result = await ((query; (lend; sql)).bind; b'ref').execute; connection
  print; (borrowed_result.rows_affected;)
  print; computed
  await connection.close;
