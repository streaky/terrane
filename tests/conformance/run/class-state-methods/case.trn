namespace class-state-methods

class counter
    value int = 0

    function construct; start int
        this.value = start

    function increase int; amount int
        this.value = this.value + amount
        return this.value

    function shifted int; amount int
        return this.value + amount

    function destruct;
        print; 'destruct'

function main;
    first counter = counter; 10
    second counter = first
    shift function from int to int = first.shifted
    print; (first.increase; 5)
    print; (second.increase; 2)
    print; (shift; 3)
