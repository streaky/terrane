namespace app

from /deps/terrane-query-witness import Holder

class Box of (T)
  value T
  function construct; value T
    this.value = move value
  consuming function take T;
    return move this.value

function unbox of (T) T; box Box of T
  return box.take;

class C
  b Box of Holder
  function construct; b Box of Holder
    this.b = move b

function main;
  c = instance C; (instance Box of Holder; (Holder::new;))
  alias = move c.b
  value = unbox; (move alias)
  print; (value.label_len;)
