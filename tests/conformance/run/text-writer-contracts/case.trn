namespace text-writer-contracts
from /standard/streams import stdout, write-result
from /core/encodings import utf8
function main;
    output = stdout;
    prefix = output.write; b'a'
    writer = output.text; utf8
    partial = write-result; b'abc', 1, false, ''
    resumed = writer.resume; partial
    line = writer.line; 'x'
    data-sync = writer.sync-data;
    all-sync = writer.sync-all;
    print; prefix.completed
    print; resumed.completed
    print; line.completed
    print; data-sync.failed
    print; all-sync.failed
    writer.close;
