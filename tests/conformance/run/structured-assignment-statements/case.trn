namespace structured-assignment-statements

class item
    x int = 0
    function construct; x int = 0
        this.x = x
        print; 'construct'
    consuming function destruct;
        print; this.x

function field-value int;
    print; 'field'
    return 5

function main;
    instance item;
    instance item; { x = field-value; }
    instance item; x = 7
    print; 'after'
