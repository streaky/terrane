namespace reentry-tuple-loop
from /core/collections import tuple
class base
    count int = 5
    function peek int; other shared ref base
        return other.count
function main;
    a = instance base;
    b = instance base;
    ha = shared ref a
    hb = shared ref b
    copy = hb
    for item in (tuple; 1, 2)
