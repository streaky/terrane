function validate-return int;
  values list of int64 = list
  index int64 = 0
  limit int64 = 100000000000000
  while index < limit
    values.append; index
    if index > 2
      return index + 1
    index++
  return 0

function validate-exit;
  values list of int64 = list
  index int64 = 0
  limit int64 = 100000000000000
  while index < limit
    values.append; index
