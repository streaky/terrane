namespace local-function-rust-owned-bindings
function main;
    function helper int; parameter int
        local = parameter + 1
        return rust
            parameter + local
    print; (helper; 4)
    max = 3
    value = 'outer'
    len = 4
    field = 5
    function math int;
        return rust
            terrane_int_support::Int::from(std::cmp::max(1 as i128, 2 as i128))
    function shadow int;
        return rust
            {
                struct Local { field: i128 }
