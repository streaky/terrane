namespace explicit-numeric-coercions

from /core/errors import coercion-error
from /core/output import print

function divide float64; numerator float64, denominator float64
  return numerator / denominator

function main;
  quantity int = 9_007_199_254_740_993
  rounded64 float64 = quantity.coerce; float64
  rounded32 float32 = quantity.coerce; float32
  print; rounded64
  print; rounded32

  signed int8 = -7
  signed-float float32 = signed.coerce; float32
  maximum uint128 = 340_282_366_920_938_463_463_374_607_431_768_211_455
  maximum-float float64 = maximum.coerce; float64
  print; signed-float
  print; maximum-float

  precise float64 = 16_777_217.0
  narrowed float32 = precise.coerce; float32
  widened float64 = narrowed.coerce; float64
  print; narrowed
  print; widened

  infinity64 = divide; 1.0, 0.0
  infinity32 float32 = infinity64.coerce; float32
  nan64 = divide; 0.0, 0.0
  nan32 float32 = nan64.coerce; float32
  print; infinity32.infinite
  print; nan32.not-a-number

  checked-integer = maximum.coerce.checked; float32
  print; checked-integer is a none

  base float64 = 65_536.0
  too-large = base * base * base * base * base * base * base * base
  checked-float = too-large.coerce.checked; float32
  print; checked-float is a none

  try
    impossible float32 = maximum.coerce; float32
    print; impossible
  catch coercion-error
    print; >integer overflow caught

  try
    impossible float32 = too-large.coerce; float32
    print; impossible
  catch coercion-error
    print; >float overflow caught
