namespace app

from /deps/terrane-query-witness import Holder, View, CopyView, Spec, Token, NE, CE, CloneEnum, query
from /core/collections import list

from /core/collections import map

function get of (T) shared ref T; values map of string, shared ref T
    return values['item']

function main;
    values map of string, shared ref Holder = map; item=(shared ref (Holder::new;))
    value = get; values
    print; (value.label_len;)
