namespace references-derived-provenance
from /core/collections import list

class holder
  value int = 0

  function construct; amount int
    this.value = amount

function pass ref int; value ref int
  return value

function consume; _value ref int

function main;
  owner = instance holder; 41
  field ref int = ref owner.value
  show-field = function;
    consume; field
    print; 'captured'
  show-field;
  values list of int = list; 1, 42
  element ref int = ref values[1]
  returned ref int = pass; element
  print; field, element, returned
  borrowed ref list of int = ref values
  for item in borrowed
    print; item
