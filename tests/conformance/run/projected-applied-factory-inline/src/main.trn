namespace app

from /deps/terrane-query-witness import Holder

class Box of (T)
  value T
  function construct; value T
    this.value = move value
  consuming function take T;
    return move this.value

function unbox of (T) T; box Box of T
  return box.take;

function wrap of (T) Box of T; value T
  return instance Box of T; (move value)

function main;
  value = unbox; (wrap; (Holder::new;))
  print; (value.label_len;)
