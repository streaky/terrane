namespace app

from /deps/terrane-callback-witness import Adjustable as adjustable, adjust_value
from /deps/terrane-callback-witness import apply_shared, apply_mutable, apply_once, apply_async, apply_async_concurrently, registrar
from /deps/terrane-callback-witness import invoke_retained, wait_until_retained_invocation_active, active_retained_invocations, pending_value
from /core/errors import dependency-panic
from /deps/terrane-dispatch-witness import dispatch
from /deps/terrane-render-witness import Renderable as renderable, render_value, render_decorated

function add-two int; value int
    return value + 2

function keep-string string; value string
    return value

async function keep-string-async string; value string
    return value

async function stay-pending int; value int
    result int = await pending_value; value
    return result

async function run-retained int;
    try
        return await invoke_retained; stay-pending
    catch dependency-panic
        return 0


function render string; label string, enabled bool
    if enabled
        return label.upper;
    return label

class projected-message implements renderable
    function render string; label string
        return label.upper;

class projected-counter implements adjustable
    total int = 0

    mutable function adjust int; delta int
        this.total = this.total + delta
        return this.total

    function current int;
        return this.total

async function main;
    print; (apply_shared; 40, add-two)
    print; (apply_mutable; 10, add-two)
    print; (apply_once; 'HELLO', keep-string)
    changed string = await apply_async; 'hello', keep-string-async
    print; changed
    offset int = 10
    add-offset = async function int; value int
        return value + offset
    concurrent int = await apply_async_concurrently; 20, add-offset
    print; concurrent
    callback-registry = registrar;
    print; (callback-registry.apply; 5, add-two)

    print; (dispatch; 'dissimilar', true, render)
    retained-scope = task-scope;
    retained-child = retained-scope.spawn; run-retained
    active bool = await wait_until_retained_invocation_active;
    retained-scope.cancel;
    retained-outcome = await retained-scope.join; retained-child
    print; active, retained-outcome.cancelled, (active_retained_invocations;)
    message = instance projected-message;
    print; (render_value; message, 'interface')
    print; (render_decorated; message, 'default')
    counter = instance projected-counter;
    print; (adjust_value; counter, 7)
