namespace inline-rust-boundaries

function add int; left int, right int
  result int = rust
    left + right
  return result

function inspect-pointer uint8;
  value uint8 = unsafe rust
    *(&7u8 as *const u8)
  return value

function rust-statement;
  rust
    println!("inline statement");

function inspect-cloned-input int; input string
  size int = rust
    terrane_int_support::Int::from(input.len() as i64)
  print; input
  return size

function borrowed-address uint64; input ref string
  return rust
    input.as_ptr() as u64

function owned-address uint64; input string
  return rust
    input.as_ptr() as u64

function identity string; value string
  return value

function optional-rust string|none; present bool
  return rust
    if present { Some(String::from("optional")) } else { None }

function main;
  print; (add; 20, 22)
  print; (inspect-pointer;)
  rust-statement;
  print; (inspect-cloned-input; 'copy me')
  input = 'owned handoff'
  address = borrowed-address; input
  print; address == (owned-address; move input)
  value = 'repeat'
  copied = identity; value
  observed string = rust
    value
  print; copied == observed
  index = 0
  while index < 2
    observed string = rust
      value
    print; observed
    index++
  callback = function string;
    return rust
      value
  print; (callback;)
  print; (callback;)
  optional = optional-rust; true
  if optional != none
    print; optional
  absent string|none = rust
    None::<String>
  print; absent == none
  direct string|none = rust
    Some(String::from("direct"))
  if direct != none
    print; direct
  missing = optional-rust; false
  print; missing == none
