namespace for-loops
function show; value string
  print; value
  value = 'parameter'
  print; value

function main;
  show; 'original'
  text string = 'éx'
  for character in text
    print; character
    character = 'loop'
    print; character
  print; text.length
  for index = 0; index < 3; index++
    if index == 1
      continue
    print; index
  print; index
  for skipped = 7; skipped < 7; skipped++
    print; 'unreachable'
  print; skipped
