namespace app
from /core/output import print
from /left import render as render-left
from /right import render as render-right
from /z-left import pick as pick-flat
from /z/left import pick as pick-nested

function apply string; callback function to string
    return callback;

function main;
    print; (apply; render-left)
    print; (apply; render-right)
    print; (apply; pick-flat)
    print; (apply; pick-nested)
