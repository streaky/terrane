namespace shared-storage-reentry-safe
class box
    count int = 1
    function peek int; other shared ref box
        return this.count + other.count
    mutable function add-from int; other shared ref box
        this.count = this.count + other.count
        return this.count

function distinct int; first shared ref box, second shared ref box
    return first.peek; second

function pick shared ref box; value shared ref box
    return value

function replaced shared ref box; value shared ref box, replacement shared ref box
    print; value.count
    value = replacement
    return value

function branch int; flag bool
    first = instance box;
    second = instance box;
    third = instance box;
    second.count = 4
    third.count = 8
    a = shared ref first
    b = shared ref second
    c = shared ref third
    copy = a
    print; copy.count
    if flag
        copy = b
    else
        copy = c
    return a.peek; copy

function main;
    plain = instance box;
    other = instance box;
    other.count = 4
    held = shared ref plain
    alternate = shared ref other
    print; (distinct; held, alternate)
    print; (held.add-from; other = alternate)
    alias = held
    print; held.count
    held = alternate
    print; (alias.peek; held)
    print; (held.peek; alias)
    print; (plain.peek; held)
    observer = ref plain
    print; (observer.peek; (pick; held))
    print; (alias.peek; (replaced; alias, held))
    print; (branch; true)
    print; (branch; false)
