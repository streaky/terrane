namespace app

from /deps/sqlx-sqlite import SqliteConnectOptions
from /deps/terrane-sqlx-lifecycle-witness import prepare_missing_path
from /deps/sqlx-core import Error
from /core/output import print

async function main;
  path = prepare_missing_path;
  missing_options = SqliteConnectOptions::new;
  missing_options = missing_options.filename; path
  missing_options = missing_options.create_if_missing; false
  try
    missing_connection = await missing_options.connect;
    print; 'unexpected-open'
    await missing_connection.close;
  catch Error
    print; 'missing'
  create_options = SqliteConnectOptions::new;
  create_options = create_options.filename; path
  create_options = create_options.create_if_missing; true
  connection = await create_options.connect;
  await connection.close;
  print; 'created-and-closed'
