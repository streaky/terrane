namespace app

from /deps/axum import Router, serve
from /deps/axum-core/response import Response
from /deps/axum/routing import get
from /deps/axum/extract import WebSocketUpgrade
from /deps/axum/extract/ws import Message, WebSocket
from /deps/axum-core import Error
from /deps/tokio/net import TcpListener
from /deps/terrane-websocket-peer-witness import drive_peer

async function socket-session; socket WebSocket
  try
    open bool = true
    while open
      message Message|none = await socket.recv;
      if message != none
        kind string = message.variant-name;
        if kind == 'Text'
          native-text = (move message).into_text;
          value string = native-text.as_str;
          if value == 'shutdown'
            print; 'close-sent'
            await (socket.send; (Message::Close; none))
            return
          print; 'text', value
          await (socket.send; (Message::text; value))
        else if kind == 'Binary'
          payload = (move message).into_data;
          print; 'binary', (payload.len;)
          await (socket.send; (Message::Binary; move payload))
        else if kind == 'Ping'
          payload = (move message).into_data;
          print; 'ping', (payload.len;)
          await (socket.send; (Message::Pong; move payload))
        else if kind == 'Pong'
          payload = (move message).into_data;
          print; 'pong', (payload.len;)
        else if kind == 'Close'
          print; 'close'
      else
        print; 'end'
        return
  catch Error
    print; 'failure'

async function health string;
  return 'ok'


function websocket-route Router; router Router, path string, handler async function from WebSocket to none
  callback = async function Response; request WebSocketUpgrade
    return request.on_upgrade; handler
  return router.route; path, (get; move callback)

async function run-server;
  router = Router::new;
  router = router.route; '/health', (get; health)
  router = websocket-route; move router, '/ws', socket-session
  listener = await TcpListener::bind; '127.0.0.1:38765'
  await (serve; move listener, move router)

async function main;
  scope = task-scope;
  server = scope.spawn; run-server
  await drive_peer;
  scope.cancel;
  _ = await scope.join; server
