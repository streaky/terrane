namespace app

from /deps/terrane-websocket-peer-witness import Error, Message, WebSocket, exercise

async function socket-session; socket WebSocket
  try
    open bool = true
    while open
      message Message|none = await socket.recv;
      if message != none
        kind string = message.variant-name;
        if kind == 'Text'
          value string = (move message).into_text;
          if value == 'shutdown'
            print; 'close-sent'
            await (socket.send; (Message::Close; none))
            return
          print; 'text', value
          await (socket.send; (Message::text; value))
        else if kind == 'Binary'
          payload = (move message).into_data;
          print; 'binary', payload.length
          await (socket.send; (Message::Binary; move payload))
        else if kind == 'Ping'
          payload = (move message).into_data;
          print; 'ping', payload.length
          await (socket.send; (Message::Pong; move payload))
        else if kind == 'Pong'
          payload = (move message).into_data;
          print; 'pong', payload.length
        else if kind == 'Close'
          print; 'close'
      else
        print; 'end'
        return
  catch Error
    print; 'failure'

async function main;
  await (exercise; socket-session)
