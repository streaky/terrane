namespace inferred-reference-provenance
from /core/collections import list

class box
    flag bool = true

function shared-flag bool; value shared ref box
  return value.flag

function count int; values ref list of int
  return values.length

function early-observer;
    named = instance box;
    observer = ref named
    alias = (observer)
    held = shared ref named
    held.flag = false
    print; observer.flag
    print; alias.flag
    print; (shared-flag; held)

function main;
  early-observer;
  value list of int = list; 1
  owner shared ref list of int = shared ref value
  observer = ref value
  observer.append; 2
  print; value.length, owner[1]
  alias = observer
  alias.append; 3
  print; value.length, observer[2]

  replacement list of int = list; 4
  replacement-owner shared ref list of int = shared ref replacement
  observer = ref replacement
  observer.append; 5
  print; replacement.length, replacement-owner[1]

  ordinary list of int = list; 6
  ordinary.append; 7
  ordinary-observer = ref ordinary
  print; ordinary.length, ordinary-observer[1]
  print; (count; ordinary-observer)

  ordinary-replacement list of int = list; 8, 9
  typed-observer ref list of int = ref ordinary
  print; typed-observer[0]
  ordinary-observer = ref ordinary-replacement
  typed-observer = ref ordinary-replacement
  print; (count; ordinary-observer), typed-observer[1]

  shared-observer ref list of int = ref value
  print; shared-observer[0]
  shared-observer = ref replacement
  print; shared-observer[0]
