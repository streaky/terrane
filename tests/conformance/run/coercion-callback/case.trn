namespace coercion-callback
from /core/errors import coercion-error

function source int;
  print; 'source'
  return 7

function render string; value int
  return 'converted'


class renderer
  function render string; value int
    return 'bound'

function fail string throws coercion-error; value int
  throw coercion-error

function main;
  print; ((source;).coerce; string, render)
  closure = function string; value int
    return 'closure'
  service renderer = instance renderer;
  bound function from int to string = service.render
  print; (8.coerce; string, closure)
  print; (9.coerce; string, bound)
  try
    print; (7.coerce; string, fail)
  catch coercion-error
    print; 'caught'
