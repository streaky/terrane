namespace class-instance-independence

class counter
    value int = 0

    function increase int;
        this.value = this.value + 1
        return this.value

function main;
    first counter = instance counter;
    second counter = instance counter;
    first-value int = first.increase;
    second-value int = second.increase;
    next-first int = first.increase;
    print; first-value, second-value, next-first
