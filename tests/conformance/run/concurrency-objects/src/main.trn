namespace concurrency-objects

from /core/output import print
from /core/concurrency import int-mutex, int-read-write-lock, atomic-int64, acquire-order, release-order, acquire-release-order, thread-local-int

function main;
    counter = instance int-mutex; 4
    counter.increase; 3
    print; (counter.load;).value

    shared = instance int-read-write-lock; 8
    shared.write; 9
    print; (shared.read;).value

    atomic = instance atomic-int64; 10
    updated = atomic.increase; 5, (acquire-release-order;)
    print; updated.failed
    print; (atomic.load; (acquire-order;)).value
    invalid-store = atomic.store; 16, (acquire-release-order;)
    print; invalid-store.failed
    invalid-ordering = atomic.load; (release-order;)
    print; invalid-ordering.failed
    print; invalid-ordering.available

    local = instance thread-local-int; 20
    local.write; 21
    print; (local.get;).value
