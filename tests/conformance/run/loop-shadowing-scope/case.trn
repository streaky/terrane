namespace loop-shadowing-scope
from /core/collections import list, map

function value int;
  return 1

function main;
  items list of string = list; 'ab', 'c'
  for items in items
    print; items
  if items is a string
    print; items

  groups map of string, list of int = map; first=(list; 1, 2)
  for entry in groups
    for entry in entry.value
      print; entry
  if entry is a int
    print; entry

  numbers list of int = list; 1, 2
  if true
    numbers string = 'ab'
    print; numbers
  print; numbers

  print; (value;)
  value int = 5
  copy int = value
  print; copy
  value int = value + 1
  print; value
