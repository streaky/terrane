namespace grouped-call-statements
function say int;
    print; 3
    return 3
function echo int; value int
    print; value
    return value
class holder
    static f function to int = say
    static g function from int to int = echo
    static function invoke;
        holder::f;
        holder::g; 4
function main;
    g = say
    (say;)
    ((g;))
    (holder::invoke;)
    ((holder::f;))
    (holder::g; 7)
    print; 1
