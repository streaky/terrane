namespace app

from /deps/terrane-query-witness import Config, Holder, query, render
from /core/collections import list

class Cfg
  sql string = 'insert'

class Outer
  cfg Cfg = instance Cfg;

class Wrapped
  inner Holder
  function construct; inner Holder
    this.inner = move inner

function callback_view host-invocation-scoped-native; cfg ref Config
  return query; cfg.sql

function observe_cfg; cfg ref Cfg
  view = query; cfg.sql
  print; (view.size;)

function observe_native; wrapped ref Wrapped
  view = wrapped.inner.view;
  print; (view.size;)

function main;
  cfg = instance Cfg;
  nested = instance Outer;
  strings list of string = list; 'indexed'
  direct = query; cfg.sql
  print; (direct.size;)
  indirect = query; nested.cfg.sql
  print; (indirect.size;)
  indexed = query; strings[0]
  print; (indexed.size;)
  observe_cfg; cfg
  wrapped = instance Wrapped; (Holder::new;)
  view = wrapped.inner.view;
  print; (view.size;)
  print; ((wrapped.inner.view;).size;)
  observe_native; wrapped
  native_cfg = Config::new;
  print; (render; native_cfg, callback_view)
