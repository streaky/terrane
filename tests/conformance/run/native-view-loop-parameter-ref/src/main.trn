namespace app

from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import list

function total int; values ref list of CopyView
    n = 0
    for c in ref values
        n = n + (c.size;)
    return n

function main;
    h = Holder::new;
    values list of CopyView = list; (h.copy_view;)
    print; (total; values)
