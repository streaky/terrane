namespace reference-return-cross-file

from /core/collections import map
from /core/errors import throwable

function locate ref point throws throwable; points ref map of int64, point, id int64
    try
        return points[id]
    catch throwable
        throw lookup-error;

function main throws throwable;
    points map of int64, point = map;
    points.set; 1, (instance point;)
    borrowed = locate; points, 1
    print; borrowed.latitude
