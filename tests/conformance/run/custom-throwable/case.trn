namespace custom-throwable
from /core/errors import throwable

class config-error implements throwable
  message string = ''
  path string = ''
  function construct; path string, message string
    this.path = path
    this.message = message
  function render string;
    return this.message

function fail string throws config-error;
  throw config-error; >settings.toml, >configuration failed

function main;
  try
    fail;
  catch config-error
    print; 'caught'
