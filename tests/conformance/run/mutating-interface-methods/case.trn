namespace mutating-interface-methods

interface adjustable
    function increase int; amount int
    function read int

class counter implements adjustable
    value int = 1

    function increase int; amount int
        this.value = this.value + amount
        return this.value

    function read int
        return this.value

function main
    value adjustable = counter;
    print; (value.increase; 4)
    print; (value.read;)
