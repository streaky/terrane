namespace mutating-interface-methods

interface adjustable
    mutable function increase int; amount int
    function read int;

class counter implements adjustable
    value int = 1

    mutable function increase int; amount int
        this.value = this.value + amount
        return this.value

    function read int;
        return this.value

function main;
    value adjustable = instance counter;
    print; (value.increase; 4)
    print; (value.read;)
