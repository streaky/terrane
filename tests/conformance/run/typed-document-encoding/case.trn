namespace typed-document-encoding

from /core/documents import document-encodable, document-decodable
from /core/documents/json import encode-typed-json, default-json-options
from /core/documents/yaml import encode-typed-yaml, default-yaml-options
from /core/collections import entry, list, map, tuple

class child implements document-encodable, document-decodable
    display string = '' metadata (external-name = 'displayName')
    count int = 0

class payload implements document-encodable, document-decodable
    title string = ''
    child child = instance child;
    enabled bool = false
    scores list of int = list; 0
    tags map of string, string = map; (entry; '', '')
    pair tuple of int = tuple; 0
    note string|none = none

function main;
    value = instance payload;
    value.title = 'sample'
    nested = instance child;
    nested.display = 'nested'
    nested.count = 4
    value.child = nested
    value.enabled = true
    value.scores = list; 7, 9
    value.tags = map; (entry; 'tier', 'edge')
    value.pair = tuple; 2, 3
    json = encode-typed-json; value, (default-json-options;)
    print; json.failed, ' ', json.value
    yaml = encode-typed-yaml; value, (default-yaml-options;)
    print; yaml.failed, ' ', yaml.value
