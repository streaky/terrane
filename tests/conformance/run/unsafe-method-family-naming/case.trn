namespace unsafe-method-family-naming

class paired-base
  function raw int;
    return 1
  unsafe function raw int;
    return 2

class safe-override extends paired-base
  function raw int;
    return 3

class safe-base
  function raw int;
    return 4

class unsafe-addition extends safe-base
  unsafe function raw int;
    return 5

interface paired-source
  function raw int;
  unsafe function raw int;

class source implements paired-source
  function raw int;
    return 6
  unsafe function raw int;
    return 7

function main;
  overridden paired-base = instance safe-override;
  print; (overridden.raw;)
  print; (unsafe overridden.raw;)
  extended = instance unsafe-addition;
  print; (extended.raw;)
  print; (unsafe extended.raw;)
  concrete = instance source;
  class-operation = concrete.raw
  abstract paired-source = concrete
  interface-operation = abstract.raw
  print; (class-operation;), (interface-operation;)
