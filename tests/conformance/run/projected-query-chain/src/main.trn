namespace app

from /deps/terrane-query-witness import ConnectionOptions, Row, query
from /deps/terrane-query-contract import QueryError

async function main;
  options = ConnectionOptions::new;
  connection = await options.connect;
  insert_op = 'insert'
  first_op = 'select'
  second_op = 'select-second'
  invalid_op = 'invalid'
  await ((query; insert_op).bind; b'first').execute; ref connection
  await ((query; insert_op).bind; b'second').execute; ref connection
  rows list of Row = await (query; first_op).fetch_all; ref connection
  print; rows.length
  row Row = await (query; first_op).fetch_one; ref connection
  body bytes = row.try_get; 'body'
  print; body[0]
  second_row Row = await (query; second_op).fetch_one; ref connection
  second_body bytes = second_row.try_get; 'body'
  print; second_body[0]
  try
    await (query; invalid_op).execute; ref connection
  catch QueryError
    print; 'query-error'
  await connection.close;
  print; 'complete'
