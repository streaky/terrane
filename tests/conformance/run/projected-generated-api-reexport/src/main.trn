namespace app

from /deps/terrane-generated-api-facade/classes import Node2D
from /deps/terrane-generated-api-facade/builtin import Vector2

function vector-length float32; x float32, y float32
    position = Vector2::new; x, y
    return position.length;

function generated-position Vector2; node ref Node2D
    return node.get_position;

function main;
    length float = vector-length; 3.0, 4.0
    print; length
    node Node2D = Node2D::new; 5.0, 12.0
    position = generated-position; node
    print; (position.length;)
