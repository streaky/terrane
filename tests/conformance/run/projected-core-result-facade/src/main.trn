namespace app

from /deps/facade import parse, maybe, pick, describe, character, text, Either as AliasResult
from /deps/facade import external, renamed, external_maybe, nested, Reader, reader, Failure, opaque
from /deps/facade import Duration, duration
from /deps/facade import Response, response
from /core/errors import throwable, dependency-error
from /core/collections import list

async function main;
    good int = parse; '41'
    print; good
    try
        print; (parse; 'bad')
    catch throwable as error
        print; 'caught: ' + error.message
    present int|none = maybe; true
    print; present != none
    absent int|none = maybe; false
    print; absent == none
    chosen = pick; true
    print; (describe; chosen)
    nominal AliasResult of (int64, string) = pick; false
    print; (describe; nominal)
    letter string|none = character; 65
    print; letter
    invalid string|none = character; 1114112
    print; invalid == none
    print; (text; (list; 117, 116, 102, 56))
    try
        print; (text; (list; 255))
    catch throwable
        print; 'invalid utf8 caught'
    print; (external; true), ':', (renamed; true)
    try
        print; (external; false)
    catch Failure
        print; 'typed external failure'
    print; (external_maybe; true)
    print; (external_maybe; false) == none
    print; (nested; false, false) == none
    print; (nested; true, true)
    try
        print; (nested; true, false)
    catch Failure
        print; 'typed nested failure'
    owner = reader;
    print; (Reader::open; true), ':', (owner.read; true), ':', (await owner.asynchronous; true)
    try
        print; (owner.read; false)
    catch Failure
        print; 'typed method failure'
    try
        print; (await owner.asynchronous; false)
    catch Failure
        print; 'typed async failure'
    print; (opaque; true)
    try
        print; (opaque; false)
    catch dependency-error as error
        print; (error.message.contains; 'opaque alias failed')
    elapsed = duration;
    print; (elapsed.as_secs;)
    constructed = Duration::from_secs; 5
    print; (constructed.as_secs;)
    packet Response = response;
    print; packet.value
