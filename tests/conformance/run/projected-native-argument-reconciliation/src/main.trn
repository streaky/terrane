namespace app

from /deps/witness import Boxed, make_i128, consume_native

function consume_generic of (T) T; value Boxed of T
    return value.into_value;

function main;
    written Boxed of int128 = make_i128;
    projected_result int128 = consume_native; written
    terrane_input Boxed of int128 = make_i128;
    terrane_result int128 = consume_generic; terrane_input
    print; projected_result
    print; terrane_result
