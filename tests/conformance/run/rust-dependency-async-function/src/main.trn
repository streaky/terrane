namespace app
from /deps/async-witness import echo_after_yield, checked_echo, timer_poll_count, socket_round_trip, wait_for_sibling, signal_sibling
from /core/errors import dependency-error
from /core/concurrency import channel, channel-block

async function source-ready string;
  return 'source-ready'


async function main;
  echoed string = await echo_after_yield; >projected async success
  print; echoed
  polls int = await timer_poll_count;
  print; polls
  message string = await socket_round_trip;
  print; message
  scope = task-scope;
  waiting = scope.spawn; wait_for_sibling
  signalling = scope.spawn; signal_sibling
  waited = await scope.join; waiting
  signalled = await scope.join; signalling
  print; waited.completed, signalled.completed
  try
    rejected string = await checked_echo; >reject
    print; rejected
  catch dependency-error
    print; 'caught projected async failure'
  selection-pair = channel; int, 0, channel-block
  selection-rx = selection-pair.receiver
  select
    case selected string = await echo_after_yield; >selected-projected
      print; selected
    case await selection-rx.receive;
      print; 'unexpected receive'
  select
    case projected = await socket_round_trip;
      print; projected
    case source = await (source-ready;)
      print; source
