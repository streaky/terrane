namespace collection-property-method-calls
from /core/collections import list, map

function main;
  values map of string, list of int = map; alpha=(list; 3, 1)
  for pair in values.entries;
    appended = pair.value.append; 2
    sorted = pair.value.sort;
    print; (pair.key.contains; 'al')
    print; appended.length, appended[2]
    print; sorted[0], sorted[1]
