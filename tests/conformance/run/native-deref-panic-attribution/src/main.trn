namespace app
from /deps/panic-api import Locks
from /core/errors import dependency-panic
function check-attribution;
    locks = Locks::new;
    with scoped-access guard = (locks.locked;) (
        try
            print; (guard.value;)
        catch dependency-panic as failure
            message = failure.message
            print; (message.contains; 'panic_api::Record::value')
    )
function main;
    check-attribution;
