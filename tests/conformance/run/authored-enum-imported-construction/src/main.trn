namespace app

from /model import state as workflow-state, unit-state as command-state

function report string; value workflow-state of string
    match ref value
        case workflow-state::pending
            return 'pending'
        case workflow-state::completed; result
            return result

function main;
    waiting workflow-state of string = instance workflow-state::pending;
    completed workflow-state of string = instance workflow-state::completed; value = 'done'
    inferred = instance workflow-state::completed; value = 'inferred'
    bare command-state = command-state::rejected
    print; (report; waiting)
    print; (report; completed)
    print; (report; inferred)
    match bare
        case command-state::rejected
            print; 'rejected'
        case else
            print; 'other'
