namespace mixed-value-reference-sequence

from /core/collections import list

function main;
  numbers list of int = list; 1
  number-snapshot list of int = numbers
  numbers.append; 2
  number-owner shared ref list of int = shared ref numbers
  number-observer ref list of int = ref numbers
  number-owner.append; 3
  print; number-snapshot.length, numbers.length, number-observer.length

  words list of string = list; 'a'
  word-snapshot list of string = words
  words.append; 'b'
  word-owner shared ref list of string = shared ref words
  word-observer ref list of string = ref words
  word-owner.append; 'c'
  print; word-snapshot[0], words[1], word-observer[2]
