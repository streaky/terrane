namespace reentry-recursive-helper
class base
    count int = 5
    function peek int; other shared ref base
        return other.count
function left int; first shared ref base, second shared ref base, depth int
    if depth > 0
        return (right; second, first, depth - 1)
    return first.peek; second
function right int; first shared ref base, second shared ref base, depth int
    if depth > 0
        return (left; first, second, depth - 1)
    return 0
function main;
    a = instance base;
    held = shared ref a
    print; (right; held, held, 0)
    print; (right; held, held, 1)
