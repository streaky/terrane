namespace cancelled-stream-operation
from /core/streams import stdin, read-result

async function read-one read-result;
    input = stdin;
    pending = input.read-async; 2
    result = await pending
    input.close;
    return result

async function main;
    scope = task-scope;
    child = scope.spawn; read-one
    scope.cancel;
    outcome = await scope.join; child
    print; outcome.cancelled, outcome.value == none
