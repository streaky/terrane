namespace adaptive-fixed-comparison

from /core/collections import list

class fixed-count
    expected int64 = 3

function main;
    values list of int = list; 1, 2, 3
    equal int64 = 3
    lower int64 = 2
    higher int64 = 4
    negative int64 = -1
    print; values.length == equal, ',', equal == values.length
    print; values.length != lower, ',', lower != values.length
    print; values.length > lower, ',', lower < values.length
    print; values.length >= equal, ',', equal <= values.length
    print; values.length < higher, ',', higher > values.length
    print; values.length <= equal, ',', equal >= values.length
    print; values.length > negative, ',', negative < values.length
    samples list of fixed-count = list; (instance fixed-count;)
    for sample in samples
        print; values.length != sample.expected, ',', values.length == sample.expected
    beyond int = 9223372036854775808
    maximum int64 = 9223372036854775807
    print; beyond > maximum, ',', maximum < beyond
    large int = 340282366920938463463374607431768211456
    current int|none = large
    bound int = large
    for step in values
        if current != none
            print; current >= bound, ',', (bound) == current
            bound = bound + step
    print; large
