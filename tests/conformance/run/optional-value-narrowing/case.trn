namespace optional-value-narrowing
from /core/collections import list

class counter
    total int = 0
    tag string|none = 'tag'
    items list of int = list; 0
    mutable function bump; amount int = 1
        this.total = this.total + amount

class derived-counter extends counter
    extra int = 0

function mutate-counter; value counter|none
    _observer = shared ref value
    if value != none
        (value).bump;
        print; value.total
        value.bump; value.total
        print; value.total
        value.total = 10
        value.total = value.total + 1
        value.items.append; value.total
        value.items[value.total - 11] = value.total + 1
        print; value.total, '/', value.items[0], '/', value.items[1]
        print; (value.tag) != none, none == value.tag
        value.tag = none
        print; value.tag == none

function helper;
    found string = 'shadow'
    print; found
function show; value int8|none
    if value != none
        print; value
function maybe int8|none;
    return 4
function missing int8|none;
    return none
function enabled bool;
    return true
function shared-snapshot string; value string|none
    _owner = shared ref value
    if value != none
        return value
    return 'missing'
function main;
    value int8|none = 7
    if (value) != none
        print; value
        value = none
        print; true
    if value != none
        print; value
    other int8|none = 8
    if none != (other)
        print; other
    show; 9
    show; none
    returned = maybe;
    if returned != none
        print; returned
    called int8|none = maybe;
    if called != none
        print; called
    missingvalue int8|none = none
    if missingvalue != none
        print; missingvalue
    missing;
    print; true
    helper;
    found = 'banana'.find; 'ana'
    if found != none
        if found != none
            print; found.text
    sharedvalue string|none = 'retained'
    _observer = shared ref sharedvalue
    print; sharedvalue != none, none == (sharedvalue)
    print; sharedvalue != none, sharedvalue
    if (sharedvalue) != none
        print; sharedvalue == none
        print; sharedvalue, sharedvalue
        snapshot string = sharedvalue
        sharedvalue = 'changed'
        print; snapshot, sharedvalue
    sharedvalue = none
    print; none == (sharedvalue)
    print; sharedvalue != none, none == sharedvalue
    print; (shared-snapshot; 'parameter')
    sharednumber int8|none = 7
    _numberowner = shared ref sharednumber
    if sharednumber != none
        print; sharednumber, sharednumber
    if enabled;
        late string|none = 'late'
        _lateowner = shared ref late
    if late != none
        print; late, late
    mutate-counter; (instance counter;)
    mutate-counter; (instance derived-counter;)
    if enabled;
        latecounter counter|none = instance counter;
        _counterowner = shared ref latecounter
    if latecounter != none
        latecounter.bump;
        latecounter.total = latecounter.total + 9
        print; latecounter.total, latecounter.tag != none
