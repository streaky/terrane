namespace app

from /core/output import print
from /core/collections import list

class option
    value int = 1

class vec
    value int = 2

class result
    value int = 3

class String
    value int = 4

class future
    value int = 1

class into-future
    value int = 2

class double-ended-iterator
    value int = 3

async function later int;
    return 41

async function main;
    absent option|none = none
    numbers list of option = list;
    maybe-numbers list of (option|none) = list; absent
    first result = instance result;
    second String = instance String;
    print; first.value
    print; second.value
    print; numbers.length
    print; maybe-numbers.length
    f = instance future;
    conversion = instance into-future;
    iterator = instance double-ended-iterator;
    print; f.value + (await later;)
    print; conversion.value
    print; iterator.value
