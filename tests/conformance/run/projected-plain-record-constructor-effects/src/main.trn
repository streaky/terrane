    try
        converted int = native_int; 9223372036854775807 * 4
        print; converted
    catch integer-conversion-overflow
        print; 'macro-overflow-caught'
    try
        print; (mark_code; (instance Mark; mark = (missing-label;)))
    catch coercion-error
        print; 'source-error-caught'
    try
        print; (macro-value; 9223372036854775807 * 4)
    catch integer-conversion-overflow
        print; 'macro-helper-overflow-caught'
