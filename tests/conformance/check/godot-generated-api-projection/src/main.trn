namespace app

from /deps/godot/classes import Node2D
from /deps/godot/builtin import Vector2

function vector-length float32; x float32, y float32
    position = Vector2::new; x, y
    return position.length;

function accepts-generated-class; node Node2D

function generated-position Vector2; node ref Node2D
    return node.get_position;

function main;
    length float = vector-length; 3.0, 4.0
