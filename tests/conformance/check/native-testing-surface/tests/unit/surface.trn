namespace native-testing-surface
from /core/testing import assert, assert-equal-int, assert-equal-string, assert-near, assert-none-string, assert-not-equal-string, assert-present-string, assert-throws, deny, fail, temporary-directory, test-failure
from /core/testing/process import process-fixture

function expected-error none throws test-failure;
    fail; 'expected'
    return none

function test-surface none throws test-failure;
    assert; true
    deny; false
    assert-equal-int; 4, 4
    assert-not-equal-string; 'left', 'right'
    assert-present-string; 'present'
    assert-none-string; none
    assert-near; 1.0, 1.1, 0.2
    assert-throws; expected-error, test-failure.identity
    fixture = instance process-fixture; 'artifact'
    assert-equal-string; fixture.artifact, 'artifact'
    temporary-directory;
    return none
