namespace app

from /deps/sqlx-sqlite import SqliteConnection, open, execute, execute_with_bytes, query_bytes, close

async function main;
    database SqliteConnection = await open; 'adapter.db'
    await (execute; database, 'CREATE TABLE values (body BLOB NOT NULL)')
    await (execute_with_bytes; database, 'INSERT INTO values (body) VALUES (?)', b'value')
    rows list of bytes = await query_bytes; database, 'SELECT body FROM values', 'body'
    await (close; move database)
