namespace reject-generic-throwable-bound
from /core/errors import throwable

class boxed-error of (T) implements throwable
  message string = ''
  function construct; message string
    this.message = message
  function render string;
    return this.message

class unrelated-error implements throwable
  message string = ''
  function render string;
    return this.message

function fail none throws unrelated-error; failure boxed-error of int
  throw failure
