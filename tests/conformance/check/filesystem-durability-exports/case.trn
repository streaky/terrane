namespace conformance/filesystem-durability-exports

from /core/filesystem/paths import path
from /core/filesystem import filesystem, file-handle, filesystem-capability, open-file, file-sync-data, file-sync-all

function exercise bool; capability filesystem, output ref file-handle
    data = file-sync-data; capability, output
    all = file-sync-all; capability, output
    return data.failed or all.failed

function main;
    capability = filesystem-capability;
    output file-handle = open-file; capability, (instance path; 'durability-check.tmp'), false, true, true, true
    exercise; capability, ref output
