namespace app
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import map

function main;
    holder = Holder::new;
    inner map of string, CopyView = map;
    inner.set; 'view', (holder.copy_view;)
    outer map of string, map of string, CopyView = map
    outer.set; 'inner', inner
    holder.bump;
    for outer-key, values in outer
        for key, value in values
            print; (value.size;)
