namespace app

from /deps/terrane-query-witness import Holder, View, CopyView, Spec, Token, NE, CE, CloneEnum, query
from /core/collections import list

class Wrapped
    inner Holder
    function construct; inner Holder
        this.inner = move inner

function go; w shared ref Wrapped
    v = w.inner.view;
    print; (v.size;)

function main;
    w = instance Wrapped; (Holder::new;)
    go; shared ref w
