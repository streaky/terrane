namespace app
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import map

function store; values mutable ref map of string, CopyView, holder Holder
    values.set; 'view', (holder.copy_view;)

function main;
    holder = Holder::new;
    values map of string, CopyView = map;
    store; values, holder
