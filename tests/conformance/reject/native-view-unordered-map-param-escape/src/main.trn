namespace app
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import unordered-map

function store; values mutable ref unordered-map of string, CopyView, holder Holder
    values.set; 'view', (holder.copy_view;)

function main;
    holder = Holder::new;
    values unordered-map of string, CopyView = unordered-map;
    store; values, holder
