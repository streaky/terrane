namespace app

from /deps/sqlx-core/query import query_with as native-query
from /deps/sqlx-core/sql-str import SqlStr as native-sql
from /deps/sqlx-sqlite import SqliteConnection as native-connection, SqliteArguments as native-arguments, SqliteRow as native-row

function query-text native-sql;
    return rust
        ::sqlx::SqlSafeStr::into_sql_str(::sqlx::AssertSqlSafe("SELECT 77"))

async function read int64; native ref native-connection
    arguments = native-arguments::default;
    sql = query-text;
    record native-row = await (native-query; sql, move arguments).fetch_one; ref native
    return 0

function main;
    print; 0
