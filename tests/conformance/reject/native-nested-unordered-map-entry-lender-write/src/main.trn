namespace app
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import unordered-map

function main;
    holder = Holder::new;
    inner unordered-map of string, CopyView = unordered-map;
    inner.set; 'view', (holder.copy_view;)
    outer unordered-map of string, unordered-map of string, CopyView = unordered-map;
    outer.set; 'inner', inner
    for outer-key, values in outer
        for key, value in values
            holder.bump;
            print; (value.size;)
