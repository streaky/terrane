namespace field-borrowed-nested-consuming
interface named
    function name int;
    consuming function finish int;
class Item implements named
    amount int = 7
    function name int;
        return this.amount
    consuming function finish int;
        return this.amount
class Inner of (T implements named)
    value T
    function construct; value T
        this.value = move value
class Outer of (T implements named)
    inner Inner of T
    function construct; value T
        this.inner = instance Inner of T; (move value)
function consume int; owner ref Outer of Item
    return owner.inner.value.finish;
function main;
    owner = instance Outer of Item; (instance Item;)
    print; (consume; owner)
