namespace app
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import map

function store; values mutable ref map of string, (map of string, CopyView), holder Holder
    inner map of string, CopyView = map;
    inner.set; 'view', (holder.copy_view;)
    values.set; 'inner', inner

function main;
    holder = Holder::new;
    values map of string, (map of string, CopyView) = map;
    store; values, holder
