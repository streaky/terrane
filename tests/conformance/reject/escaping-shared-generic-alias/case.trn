namespace escaping-shared-generic-alias
interface named
    function name int;
class value implements named
    function name int;
        return 1
function identity of (F) F; input F
    return input
function mk of (T implements named) function to int; item T
    f = function int;
        return item.name;
    return identity; f
function main;
    f = mk; (instance value;)
    print; (f;)
