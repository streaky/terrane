namespace escaping-owned-collection-parameter
from /core/collections import list
interface named
    function name int;

class value implements named
    amount int = 1
    function name int;
        return this.amount

function go of (T implements named); fs list of function to int, item T
    fs.append; function int;
        return item.name;

function main;
    fs list of function to int = list;
    go; fs, (instance value;)
    print; fs.length
