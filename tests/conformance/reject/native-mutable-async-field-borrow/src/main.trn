namespace app
from /deps/terrane-borrowed-future-witness import Builder
function present bool; value ref (Builder|none)
    return value != none
class holder
    value Builder|none = none
    function construct; value Builder|none
        this.value = move value
    mutable async function check bool;
        return present; (ref this.value)
async function main;
    h = instance holder; (Builder::new;)
    print; (await h.check;)
