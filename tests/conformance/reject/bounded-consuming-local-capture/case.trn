namespace bounded-consuming-local-capture
from /core/collections import list
interface named
    function name int;

class value implements named
    amount int = 1
    function name int;
        return this.amount

function go of (T implements named) int; item T
    g = consuming function int;
        return item.name;
    return g;

function main;
    print; (go; (instance value;))
