namespace generic-return-throwing-call-catch-opt
from /core/collections import list
from /core/errors import throwable

class Err implements throwable
    message string = 'x'
    function render string;
        return this.message

function bad int;
    throw instance Err;

function eat of (T) T; x T
    print; (bad;)
    return x

function f of (T) T; o T|none, d T
    for i in (list; 1, 2)
        try
            if o != none
                return (eat; o)
        catch
            print; i
    if o != none
        return o
    return d

function main;
    print; (f; (list; 1), (list; 2, 3)).length
