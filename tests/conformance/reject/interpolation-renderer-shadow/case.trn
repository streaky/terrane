namespace interpolation-renderer-shadow
from /core/modifiers import interpolation-renderer
function first string; value int
    return 'A' + value
function second string; value int
    return 'B' + value
function main;
    with (interpolation-renderer; key = 'k') renderer function from int to string = first
    function inner string; renderer function from int to string
        return "{1 !: k}"
    print; (inner; second)
