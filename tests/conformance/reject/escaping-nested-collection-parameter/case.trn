namespace escaping-nested-collection-parameter
from /core/collections import list
interface named
    function name int;

class value implements named
    amount int = 1
    function name int;
        return this.amount

function go of (T implements named); fs mutable ref list of list of function to int, item T
    callback = function int;
        return item.name;
    inner list of function to int = list; callback
    fs.append; inner
function main;
    fs list of list of function to int = list;
    go; fs, (instance value;)
    print; fs.length
