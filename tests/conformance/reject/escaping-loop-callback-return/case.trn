namespace escaping-loop-callback-return
from /core/collections import list
interface named
    function name int;

class value implements named
    amount int = 1
    function name int;
        return this.amount

function go of (T implements named) function to int; item T
    l list of function to int = list;
    l.append; function int;
        return item.name;
    for cb in l
        return cb
    return function int;
        return 0

function main;
    g = go; (instance value;)
    print; (g;)
