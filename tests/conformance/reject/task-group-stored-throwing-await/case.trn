namespace task-group-stored-throwing-await
from /core/errors import throwable, coercion-error

async function risky-int int throws throwable;
    throw coercion-error

async function child int;
    return 1

async function main;
    group = task-group; int
    group.spawn; (child;)
    pending = (risky-int;)
    _ = await pending
    _ = await group.drain;
