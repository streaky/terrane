namespace pipeline-inline-pair-shared

from /core/collections import list
from /core/modifiers import pipeline-sequential

function run; values mutable ref list of int
    other = list; 7, 8
    with pipeline-sequential result = other
        .map; (function int; value int
            return value + values.length)
        .map; (mutable function int; value int
            return value + values.length)
        .collect;
    print; result.length

function main;
    values = list; 1, 2, 3
    run; values
