namespace app
from /core/collections import list
function eat int; o list of int
    return o.length

from /core/errors import throwable

class Err implements throwable
    message string = 'x'
    function render string;
        return this.message

function bad int;
    throw instance Err;

function main;
    o list of int = list; 1
    try
        print; (eat; move o)
        print; (bad;)
    catch
        print; o[0]
    finally
        o = list; 2
    print; o[0]

