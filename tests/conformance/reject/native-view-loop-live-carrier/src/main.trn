namespace app
from /deps/terrane-query-witness import Holder, CopyView
from /core/collections import list

function main;
    holder = Holder::new;
    values = list; (holder.copy_view;)
    for value in ref values
        print; (value.size;)
    for value in values
        print; (value.size;)
    if value is not none
        print; (value.size;)
