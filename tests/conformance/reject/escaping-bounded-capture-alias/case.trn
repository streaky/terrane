namespace escaping-bounded-capture-alias
from /core/collections import list
interface named
    function name int;

class value implements named
    amount int = 1
    function name int;
        return this.amount

function mk of (T implements named) function to int; item T
    f = function int;
        return item.name;
    alias = f
    return alias

function main;
    g = mk; (instance value;)
    print; (g;)
