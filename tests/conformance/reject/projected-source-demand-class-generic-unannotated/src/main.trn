namespace app

from /deps/terrane-query-witness import Holder, View, CopyView, Spec, Token, NE, CE, CloneEnum, query
from /core/collections import list

class Box of (T)
    value T
    function construct; value T
        this.value = move value
    consuming function take T;
        return move this.value

function main;
    box = instance (Box of Holder); (Holder::new;)
    value = box.take;
    print; (value.label_len;)
