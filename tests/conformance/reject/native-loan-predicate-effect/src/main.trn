namespace app
from /deps/terrane-query-witness import Holder, View, query
from /core/collections import list
class W
    inner Holder
    other Holder
    function construct; inner Holder, other Holder
        this.inner = move inner
        this.other = move other
function change bool; h mutable ref Holder
    h.bump;
    return false
function main;
    w = instance W; (Holder::new;), (Holder::new;)
    v = w.inner.view;
    switch
        case (change; w.inner)
            print; 7
        case else
            print; (v.size;)
