namespace security-contracts

from /core/testing import assert-equal-int, assert-equal-string, assert, test-package-root
from /core/errors import throwable
from /core/collections import list, range
from /core/documents import document-value
from /core/documents/json import parse-json, default-json-options
from /core/filesystem import filesystem-capability, filesystem-read-bounded
from /core/filesystem/paths import path as filesystem-path

function check-marker-fixture throws throwable; fixture document-value
    name = (fixture.field; 'name').value.scalar
    source = (fixture.field; 'source').value.scalar
    path = (fixture.field; 'path').value.scalar
    expected-error = fixture.field; 'error'
    if not expected-error.failed
        message string = ''
        try
            scan-regions; path, source
        catch security-error as error
            message = error.render;
        require; (message.contains; expected-error.value.scalar), name, message
        return
    expected = fixture.field; 'regions'
    require; not expected.failed and expected.value.kind == 'list', name, 'expected a region list'
    regions = scan-regions; path, source
    count = expected.value.length;
    require; regions.length == count, name, 'unexpected region count'
    for index in (range; 0, count)
        entry = (expected.value.item; index).value
        identity = (entry.item; 0).value.scalar
        start = (entry.item; 1).value.scalar
        end = (entry.item; 2).value.scalar
        region = regions[index]
        require; region.identity == identity and "{region.start}" == start and "{region.end}" == end, name, 'unexpected region identity or lines'

function test-shared-marker-corpus throws throwable;
    root = test-package-root;
    path string = ''
    if root != none
        path = root.concat; '/tests/fixtures/security-markers.json'
    else
        throw instance security-error; 'missing test package root'
    loaded = filesystem-read-bounded; (filesystem-capability;), (instance filesystem-path; path), 65536
    require; not loaded.failed, path, loaded.message
    corpus = parse-json; (decode-source; loaded.data), (default-json-options;)
    require; not corpus.failed and corpus.value.kind == 'list', path, 'expected a JSON fixture list'
    count = corpus.value.length;
    require; count > 0, path, 'fixture list is empty'
    for index in (range; 0, count)
        fixture = corpus.value.item; index
        require; not fixture.failed and fixture.value.kind == 'map', path, 'expected a fixture mapping'
        check-marker-fixture; fixture.value

function test-marker-errors-do-not-silently-drop-coverage throws throwable;
    cases list of string = list
    cases.append; "//# SECURITY-END [x]"
    cases.append; "//# SECURITY-BEGIN [x]"
    cases.append; "//# SECURITY-BEGIN [a]\n//# SECURITY-BEGIN [b]\n//# SECURITY-END [a]\n//# SECURITY-END [b]"
    cases.append; "//# SECURITY-BEGIN [bad id]\n//# SECURITY-END [bad id]"
    cases.append; "//# SECURITY-BEGIN [x] trailing prose\n//# SECURITY-END [x]"
    cases.append; "fn f() {{}} //# SECURITY-BEGIN [x]\n//# SECURITY-END [x]"
    cases.append; "/* unterminated //# SECURITY-BEGIN [x]"
    for source in cases
        rejected bool = false
        try
            scan-regions; 'sample.rs', source
        catch security-error
            rejected = true
        assert; rejected

function test-marker-lookalikes-are-ordinary-comments throws throwable;
    source = >>
        // Security-sensitive: validate untrusted input.
        /// Security-relevant helper.
        /* Security-related notes. */
        // SECURITY-BEGIN[legacy]
        /// SECURITY-BEGIN [doc]
        //! SECURITY-END [doc]
        //# security-begin [lowercase]
        //#SECURITY-BEGIN [spacing]
        //# SECURITY-END[spacing]
        /* //# SECURITY-BEGIN [block] */
        //# SECURITY-BEGIN [real]
        // Security-sensitive implementation.
        //# SECURITY-END [real]
    regions = scan-regions; 'sample.rs', source
    assert-equal-int; regions.length, 1
    assert-equal-int; regions[0].start, 11
    assert-equal-int; regions[0].end, 13
    terrane-source = "# security-review: done\n# SECURITY-BEGIN [hash]\n//# SECURITY-BEGIN [real]\n//# SECURITY-END [real]"
    terrane-regions = scan-regions; 'sample.trn', terrane-source
    assert-equal-int; terrane-regions.length, 1

function test-indentation-crlf-and-adjacent-regions throws throwable;
    source = "    //# SECURITY-BEGIN [first] \r\n    //# SECURITY-END [first]\r\n//# SECURITY-BEGIN [second]\n//# SECURITY-END [second]"
    regions = scan-regions; 'sample.trn', source
    assert-equal-int; regions.length, 2
    assert-equal-int; regions[1].start, 3

function test-terrane-block-comments-end-at-first-terminator throws throwable;
    source = >>
        /* outer /* not nested */
        //# SECURITY-BEGIN [real]
        value = '*/'
        //# SECURITY-END [real]
    regions = scan-regions; 'sample.trn', source
    assert-equal-int; regions.length, 1
    assert-equal-int; regions[0].start, 2
    assert-equal-int; regions[0].end, 4

function test-ordinary-rust-identifier-does-not-open-native-block throws throwable;
    source = >>
        call; rust, '//# SECURITY-BEGIN [hidden]'
        value = options.rust
            '//# SECURITY-BEGIN [also-hidden]'
        //# SECURITY-BEGIN [real]
        //# SECURITY-END [real]
    regions = scan-regions; 'sample.trn', source
    assert-equal-int; regions.length, 1
    assert-equal-string; regions[0].identity, 'real'
