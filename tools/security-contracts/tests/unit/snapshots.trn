namespace security-contracts

from /core/testing import assert, assert-equal-int
from /core/errors import throwable

function security-fixture string throws throwable;
    root = fixture-root;
    // The core filesystem API has no directory-creation operation. Fixture
    // scaffolding alone uses Rust; remove this when core can create directories.
    rust
        for directory in ["docs/security", "src", "tests"] {
            std::fs::create_dir_all(std::path::Path::new(&root).join(directory)).expect("create test directories");
        }
    fixture-write; root, 'docs/security/sample.yaml', (sample-contract;)
    fixture-write; root, 'src/guard.rs', "// SECURITY-BEGIN[sample.contract]\nfn guard() {{}}\n// SECURITY-END[sample.contract]\n"
    fixture-write; root, 'tests/guard.trn', 'source-level evidence'
    return root

function test-snapshot-links-regions-to-records throws throwable;
    root = security-fixture;
    snapshot = load-snapshot; root
    assert-equal-int; snapshot.contracts.length, 1
    assert-equal-int; snapshot.regions.length, 1
    assert; snapshot.regions[0].identity == snapshot.contracts[0].identity

function test-snapshot-rejects-unknown-marker-contract throws throwable;
    root = security-fixture;
    fixture-write; root, 'src/guard.rs', "// SECURITY-BEGIN[unknown]\n// SECURITY-END[unknown]\n"
    message string = ''
    try
        load-snapshot; root
    catch security-error as error
        message = error.render;
    assert; (message.contains; 'unknown contract unknown')

function test-snapshot-rejects-removed-enforcement-marker throws throwable;
    root = security-fixture;
    fixture-write; root, 'src/guard.rs', 'fn guard() {}'
    message string = ''
    try
        load-snapshot; root
    catch security-error as error
        message = error.render;
    assert; (message.contains; 'missing enforcement region')

function test-snapshot-rejects-duplicate-record-identities throws throwable;
    root = security-fixture;
    fixture-write; root, 'docs/security/duplicate.yaml', (sample-contract;)
    message string = ''
    try
        load-snapshot; root
    catch security-error as error
        message = error.render;
    assert; (message.contains; 'duplicate contract identity')

function test-snapshot-rejects-missing-evidence-file throws throwable;
    root = security-fixture;
    source = (sample-contract;).replace; 'tests/guard.trn', 'tests/missing.trn'
    fixture-write; root, 'docs/security/sample.yaml', source
    message string = ''
    try
        load-snapshot; root
    catch security-error as error
        message = error.render;
    assert; (message.contains; 'missing referenced file tests/missing.trn')

function test-base-snapshot-checks-mixed-case-markers throws throwable;
    root = security-fixture;
    fixture-write; root, 'src/other.rs', '// security-begin[sample.contract]'
    fixture-commit; root
    base = resolve-revision; root, 'HEAD'
    message string = ''
    try
        load-snapshot; root, base
    catch security-error as error
        message = error.render;
    assert; (message.contains; 'malformed security marker')
