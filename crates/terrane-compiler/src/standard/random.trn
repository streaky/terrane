namespace standard/random

from /core/types import int, bool, string, bytes
from /core/platform-capabilities import platform-capability
from /core/platform-capabilities import secure-random as platform-secure, pseudo-random as platform-pseudo
from /core/platform-capabilities import random-bytes, random-bounded, random-split, secret-buffer as platform-secret, destroy-secret as platform-destroy-secret
from /core/platform-capabilities import digest as platform-digest, hmac as platform-hmac, constant-time-equal
from /core/platform-capabilities import result-failed, result-message, result-bytes, result-int, result-capability

class byte-result
    failed bool = false
    message string = ''
    value bytes = b''

    function construct; failed bool, message string, data bytes
        this.failed = failed
        this.message = message
        this.value = data

class int-result
    failed bool = false
    message string = ''
    value int = 0

    function construct; failed bool, message string, number int
        this.failed = failed
        this.message = message
        this.value = number

class secret-operation-result
    failed bool = false
    message string = ''

    function construct; failed bool, message string
        this.failed = failed
        this.message = message

class secret-buffer
    handle platform-capability = platform-secret; b''

    function construct; data bytes
        this.handle = platform-secret; data

function destroy-secret secret-operation-result; secret secret-buffer
    raw = platform-destroy-secret; secret.handle
    return secret-operation-result; (result-failed; raw), (result-message; raw)

class digest-value
    algorithm string = ''
    value bytes = b''

    function construct; algorithm string, data bytes
        this.algorithm = algorithm
        this.value = data

    function constant-time-equals bool; other digest-value
        if this.algorithm != other.algorithm
            return false
        left = this.value
        return constant-time-equal; left, other.value

class digest-result
    failed bool = false
    message string = ''
    value digest-value = digest-value; '', b''

    function construct; failed bool, message string, digest digest-value
        this.failed = failed
        this.message = message
        this.value = digest

class signature-value
    algorithm string = ''
    value bytes = b''

    function construct; algorithm string, data bytes
        this.algorithm = algorithm
        this.value = data

    function constant-time-equals bool; other signature-value
        if this.algorithm != other.algorithm
            return false
        left = this.value
        return constant-time-equal; left, other.value

class signature-result
    failed bool = false
    message string = ''
    value signature-value = signature-value; '', b''

    function construct; failed bool, message string, signature signature-value
        this.failed = failed
        this.message = message
        this.value = signature

class secure-random
    handle platform-capability = platform-secure;

    function construct;
        this.handle = platform-secure;

    function generate-bytes byte-result; count int
        raw = random-bytes; this.handle, count
        return byte-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)

    function bounded-int int-result; upper-exclusive int
        raw = random-bounded; this.handle, upper-exclusive
        return int-result; (result-failed; raw), (result-message; raw), (result-int; raw)

class pseudo-random-algorithm
    name string = ''

    function construct; name string
        this.name = name

function chacha20 pseudo-random-algorithm;
    return pseudo-random-algorithm; 'chacha20'

class pseudo-random
    handle platform-capability = platform-pseudo; 'chacha20', b''

    function construct; algorithm pseudo-random-algorithm, seed bytes
        this.handle = platform-pseudo; algorithm.name, seed

    function generate-bytes byte-result; count int
        raw = random-bytes; this.handle, count
        return byte-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)

    function bounded-int int-result; upper-exclusive int
        raw = random-bounded; this.handle, upper-exclusive
        return int-result; (result-failed; raw), (result-message; raw), (result-int; raw)

    function split pseudo-random;
        raw = random-split; this.handle
        child = pseudo-random; (chacha20;), b''
        child.handle = result-capability; raw
        return child

function split-pseudo pseudo-random; source pseudo-random
    raw = random-split; source.handle
    child = pseudo-random; (chacha20;), b''
    child.handle = result-capability; raw
    return child
function secure-bytes byte-result; source secure-random, count int
    raw = random-bytes; source.handle, count
    return byte-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)

function pseudo-bytes byte-result; source pseudo-random, count int
    raw = random-bytes; source.handle, count
    return byte-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)

function secure-bounded-int int-result; source secure-random, upper-exclusive int
    raw = random-bounded; source.handle, upper-exclusive
    return int-result; (result-failed; raw), (result-message; raw), (result-int; raw)

function pseudo-bounded-int int-result; source pseudo-random, upper-exclusive int
    raw = random-bounded; source.handle, upper-exclusive
    return int-result; (result-failed; raw), (result-message; raw), (result-int; raw)

class hash-algorithm
    name string = ''

    function construct; name string
        this.name = name


function sha256 hash-algorithm;
    return hash-algorithm; 'sha-256'

function sha512 hash-algorithm;
    return hash-algorithm; 'sha-512'

function digest-bytes digest-result; algorithm hash-algorithm, data bytes
    raw = platform-digest; algorithm.name, data
    value = digest-value; algorithm.name, (result-bytes; raw)
    return digest-result; (result-failed; raw), (result-message; raw), value

function sign-hmac signature-result; algorithm hash-algorithm, key secret-buffer, data bytes
    raw = platform-hmac; algorithm.name, key.handle, data
    value = signature-value; algorithm.name, (result-bytes; raw)
    return signature-result; (result-failed; raw), (result-message; raw), value

function digest-equals bool; left digest-value, right digest-value
    return left.constant-time-equals; right

function signature-equals bool; left signature-value, right signature-value
    return left.constant-time-equals; right
