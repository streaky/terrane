namespace standard/concurrency

from /core/types import int, int64, bool, string

class operation-result
    failed bool = false
    deadline-exceeded bool = false
    message string = ''

    function construct; did-fail bool, exceeded-deadline bool, detail string
        this.failed = did-fail
        this.deadline-exceeded = exceeded-deadline
        this.message = detail

class cancellation-token
    handle platform-capability = platform-cancellation-token;

    function cancel operation-result;
        raw = platform-cancel; this.handle
        return operation-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-message; raw)

class operation-options
    deadline-ms int = 30000
    cancellation cancellation-token = cancellation-token;

    function construct; deadline-ms int, cancellation cancellation-token
        this.deadline-ms = deadline-ms
        this.cancellation = cancellation

function cancel-operation operation-result; cancellation cancellation-token
    raw = platform-cancel; cancellation.handle
    return operation-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-message; raw)

class int-result
    failed bool = false
    deadline-exceeded bool = false
    available bool = false
    message string = ''
    value int = 0

    function construct; did-fail bool, exceeded-deadline bool, has-value bool, detail string, result-value int
        this.failed = did-fail
        this.deadline-exceeded = exceeded-deadline
        this.available = has-value
        this.message = detail
        this.value = result-value

class int-channel
    failed bool = false
    message string = ''
    handle platform-capability = no-capability;

    function construct; capacity int
        raw = platform-int-channel; capacity
        this.failed = result-failed; raw
        this.message = result-message; raw
        this.handle = result-capability; raw

    function send operation-result; value int, options operation-options
        raw = platform-channel-send; this.handle, value, options.deadline-ms, options.cancellation.handle
        return operation-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-message; raw)

    function receive int-result; options operation-options
        raw = platform-channel-receive; this.handle, options.deadline-ms, options.cancellation.handle
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

    function try-receive int-result;
        raw = platform-channel-try-receive; this.handle
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

class int-mutex
    failed bool = false
    message string = ''
    handle platform-capability = no-capability;

    function construct; initial int
        raw = platform-int-mutex; initial
        this.failed = result-failed; raw
        this.message = result-message; raw
        this.handle = result-capability; raw

    function load int-result;
        raw = platform-mutex-load; this.handle
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

    function store operation-result; value int
        raw = platform-mutex-store; this.handle, value
        return operation-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-message; raw)

    function increase int-result; amount int
        raw = platform-mutex-add; this.handle, amount
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

class int-read-write-lock
    failed bool = false
    message string = ''
    handle platform-capability = no-capability;

    function construct; initial int
        raw = platform-int-read-write-lock; initial
        this.failed = result-failed; raw
        this.message = result-message; raw
        this.handle = result-capability; raw

    function read int-result;
        raw = platform-read-write-lock-read; this.handle
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

    function write operation-result; value int
        raw = platform-read-write-lock-write; this.handle, value
        return operation-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-message; raw)

class memory-order
    name string = 'sequentially-consistent'

    function construct; ordering-name string
        this.name = ordering-name


function relaxed-order memory-order;
    return memory-order; 'relaxed'


function acquire-order memory-order;
    return memory-order; 'acquire'


function release-order memory-order;
    return memory-order; 'release'


function acquire-release-order memory-order;
    return memory-order; 'acquire-release'


function sequentially-consistent-order memory-order;
    return memory-order; 'sequentially-consistent'


class atomic-int64
    failed bool = false
    message string = ''
    handle platform-capability = no-capability;

    function construct; initial int64
        raw = platform-atomic-int64; initial
        this.failed = result-failed; raw
        this.message = result-message; raw
        this.handle = result-capability; raw

    function load int-result; ordering memory-order
        raw = platform-atomic-load; this.handle, ordering.name
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

    function store operation-result; value int64, ordering memory-order
        raw = platform-atomic-store; this.handle, value, ordering.name
        return operation-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-message; raw)

    function increase int-result; amount int64, ordering memory-order
        raw = platform-atomic-add; this.handle, amount, ordering.name
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

class thread-local-int
    failed bool = false
    message string = ''
    handle platform-capability = no-capability;

    function construct; initial int
        raw = platform-thread-local-int; initial
        this.failed = result-failed; raw
        this.message = result-message; raw
        this.handle = result-capability; raw

    function get int-result;
        raw = platform-thread-local-get; this.handle
        return int-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-bool; raw), (result-message; raw), (result-int; raw)

    function write operation-result; value int
        raw = platform-thread-local-set; this.handle, value
        return operation-result; (result-failed; raw), (result-deadline-exceeded; raw), (result-message; raw)
