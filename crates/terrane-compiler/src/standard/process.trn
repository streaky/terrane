namespace standard/process

from /core/types import int, bool, string, bytes, none
from /core/collections import list
from /core/platform-system import process-arguments as platform-arguments
from /core/platform-system import environment-entries as platform-environment
from /core/platform-system import process-exit as platform-exit
from /core/platform-system import platform-value-is-text, platform-value-text, platform-value-bytes

class platform-string
    is-text bool = true
    text string = ''
    raw bytes = b''

    function construct; encoded string
        this.is-text = platform-value-is-text; encoded
        this.text = platform-value-text; encoded
        this.raw = platform-value-bytes; encoded

class environment-entry
    name platform-string = platform-string; 'text:'
    value platform-string = platform-string; 'text:'

    function construct; name platform-string, entry-value platform-string
        this.name = name
        this.value = entry-value

function arguments list of platform-string;
    encoded = (platform-arguments;)
    values list of platform-string = list
    index int = 0
    while index < encoded.length
        values.append; (platform-string; encoded[index])
        index = index + 1
    return values

function environment list of environment-entry;
    encoded = (platform-environment;)
    values list of environment-entry = list
    index int = 0
    while index < encoded.length
        name = platform-string; encoded[index]
        value = platform-string; encoded[index + 1]
        values.append; (environment-entry; name, value)
        index = index + 2
    return values

class cli-schema
    entries list of string = list

    function construct; declared list of string
        this.entries = declared

class command-line
    flags list of string = list
    option-names list of string = list
    option-values list of platform-string = list
    positionals list of platform-string = list
    diagnostic-arguments list of int = list
    diagnostic-messages list of string = list


function schema-has bool; schema cli-schema, sought string
    for entry in schema.entries
        if entry == sought
            return true
    return false

function parse-command-line command-line; schema cli-schema, supplied list of platform-string
    flags list of string = list
    option-names list of string = list
    option-values list of platform-string = list
    positionals list of platform-string = list
    diagnostic-arguments list of int = list
    diagnostic-messages list of string = list
    index int = 0
    while index < supplied.length
        argument = supplied[index]
        if not argument.is-text
            diagnostic-arguments.append; index
            diagnostic-messages.append; 'command-line option is not Unicode text'
        else
            flag-entry = 'flag:'.concat; argument.text
            value-entry = 'value:'.concat; argument.text
            if (schema-has; schema, flag-entry)
                flags.append; argument.text
            else if (schema-has; schema, value-entry)
                if index + 1 >= supplied.length
                    diagnostic-arguments.append; index
                    diagnostic-messages.append; 'option requires a value'
                else
                    option-names.append; argument.text
                    option-values.append; supplied[index + 1]
                    index = index + 1
            else if (argument.text.contains.start; '--')
                diagnostic-arguments.append; index
                diagnostic-messages.append; 'unknown option'
            else
                positionals.append; argument
        index = index + 1
    result = (command-line;)
    result.flags = flags
    result.option-names = option-names
    result.option-values = option-values
    result.positionals = positionals
    result.diagnostic-arguments = diagnostic-arguments
    result.diagnostic-messages = diagnostic-messages
    return result

class exit-status
    code int = 0
    valid bool = true


function make-exit-status exit-status; requested int
    result = (exit-status;)
    if requested < 0 or requested > 255
        result.code = 255
        result.valid = false
    else
        result.code = requested
    return result

function exit; status exit-status
    platform-exit; status.code
