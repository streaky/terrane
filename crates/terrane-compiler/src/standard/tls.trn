namespace standard/tls

from /core/types import int, bool, string, bytes
from /core/platform-capabilities import platform-resource-handle
from /core/platform-capabilities import tls-client as platform-client, tls-read, tls-write, close as platform-close
from /core/platform-capabilities import result-failed, result-message, result-bytes, result-int, result-bool, result-resource
from /standard/networking import tcp-stream, operation-options, operation-result, io-result, host-name

class tls-stream
    handle platform-resource-handle

    function read io-result; limit int, options operation-options
        raw = tls-read; this.handle, limit, options.deadline-ms, options.cancelled
        return io-result; (result-failed; raw), false, (result-message; raw), (result-bytes; raw), (result-int; raw), '', (result-bool; raw)

    function write io-result; data bytes, options operation-options
        raw = tls-write; this.handle, data, options.deadline-ms, options.cancelled
        return io-result; (result-failed; raw), false, (result-message; raw), b'', (result-int; raw), '', false

    function close operation-result;
        raw = platform-close; this.handle
        return operation-result; (result-failed; raw), (result-message; raw)

    function destruct;
        platform-close; this.handle

class tls-result
    failed bool = false
    message string = ''
    value tls-stream = tls-stream;

    function construct; failed bool, message string, stream tls-stream
        this.failed = failed
        this.message = message
        this.value = stream

# Certificate-chain and hostname validation are unconditional on this ordinary connector.
# An insecure connector is intentionally absent; it can only live in a separately imported unsafe package.
function connect-tls tls-result; stream tcp-stream, server-name host-name, options operation-options
    raw = platform-client; stream.handle, server-name.value, options.deadline-ms, options.cancelled
    value = tls-stream;
    if not (result-failed; raw)
        value.handle = result-resource; raw
    return tls-result; (result-failed; raw), (result-message; raw), value
