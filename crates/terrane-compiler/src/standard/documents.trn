namespace standard/documents

from /core/types import int, bool, string
from /core/collections import list
from /core/platform-data import platform-data-result
from /core/platform-data import make-document-none as platform-make-none, make-document-bool as platform-make-bool
from /core/platform-data import make-document-string as platform-make-string, make-document-integer as platform-make-integer
from /core/platform-data import make-document-decimal as platform-make-decimal, make-document-list as platform-make-list
from /core/platform-data import document-list-append as platform-list-append, make-document-map as platform-make-map
from /core/platform-data import document-map-insert as platform-map-insert
from /core/platform-data import empty-document
from /core/platform-data import data-failed, data-message, data-path, data-expected, data-encoded
from /core/platform-data import document-kind as platform-kind, document-text as platform-text
from /core/platform-data import document-coefficient as platform-coefficient, document-exponent as platform-exponent
from /core/platform-data import document-length as platform-length, document-item as platform-item
from /core/platform-data import document-key as platform-key, document-field as platform-field
from /core/platform-data import validate-mapping

class document-integer
    text string = '0'

    function construct; text string
        this.text = text

class document-decimal
    coefficient string = '0'
    exponent int = 0
    text string = '0'

    function construct; coefficient string, exponent int, text string
        this.coefficient = coefficient
        this.exponent = exponent
        this.text = text

interface serializable
    function to-document document-value;

interface deserializable
    function from-document document-result; value document-value

class document-value implements serializable
    raw platform-data-result = empty-document;
    encoded string = ''
    kind string = 'invalid'
    scalar string = ''
    integer document-integer = document-integer; '0'
    decimal document-decimal = document-decimal; '0', 0, '0'

    function construct; raw platform-data-result
        this.kind = platform-kind; raw
        this.scalar = platform-text; raw
        this.encoded = data-encoded; raw
        if this.kind == 'integer'
            this.integer = document-integer; this.scalar
        if this.kind == 'decimal'
            this.decimal = document-decimal; (platform-coefficient; raw), (platform-exponent; raw), this.scalar
        this.raw = raw

    function length int;
        return platform-length; this.raw

    function to-document document-value;
        return this

    function item document-result; index int
        raw = platform-item; this.raw, index
        return make-document-result; raw

    function key string; index int
        return platform-key; this.raw, index

    function field document-result; name string
        raw = platform-field; this.raw, name
        return make-document-result; raw

class document-result
    failed bool = false
    message string = ''
    path string = '$'
    expected string = ''
    value document-value = document-value; (empty-document;)

    function construct; failed bool, message string, path string, expected string, raw platform-data-result
        this.failed = failed
        this.message = message
        this.path = path
        this.expected = expected
        this.value = document-value; raw

class document-mapping implements deserializable
    descriptor-name string = 'document-value'
    expected-kind string = 'map'
    field-names list of string = list; ''
    optional-fields list of string = list; ''
    default-fields list of string = list; ''
    default-values list of string = list; ''
    allow-unknown bool = false

    function construct; descriptor-name string, expected-kind string, allow-unknown bool
        this.descriptor-name = descriptor-name
        this.expected-kind = expected-kind
        this.allow-unknown = allow-unknown


    function from-document document-result; value document-value
        return decode-document; value, this

function serialize-document document-value; value serializable
    return value.to-document;

function deserialize-document document-result; value document-value, destination deserializable
    return destination.from-document; value

function make-document-result document-result; raw platform-data-result
    return document-result; (data-failed; raw), (data-message; raw), (data-path; raw), (data-expected; raw), raw


function make-document-none document-value;
    return document-value; (platform-make-none;)

function make-document-bool document-value; value bool
    return document-value; (platform-make-bool; value)

function make-document-string document-value; value string
    return document-value; (platform-make-string; value)

function make-document-integer document-result; value string
    return make-document-result; (platform-make-integer; value)

function make-document-decimal document-result; value string
    return make-document-result; (platform-make-decimal; value)
class document-map-entries
    raw platform-data-result = platform-make-map;

    function construct;
        this.raw = platform-make-map;

    function append; key string, value document-value
        this.raw = platform-map-insert; this.raw, key, value.raw

function append-document-map-entry document-map-entries; entries document-map-entries, key string, value document-value
    entries.append; key, value
    return entries

function make-document-list document-result; values list of document-value
    raw = platform-make-list;
    index int = 0
    while index < values.length
        raw = platform-list-append; raw, values[index].raw
        index = index + 1
    return make-document-result; raw

function make-document-map document-result; entries document-map-entries
    return make-document-result; entries.raw
function mapping-required-fields list of string; mapping document-mapping
    fields = mapping.field-names
    optional-fields = mapping.optional-fields
    default-fields = mapping.default-fields
    required list of string = list;
    index int = 0
    while index < fields.length
        field = fields[index]
        optional bool = false
        optional-index int = 0
        while optional-index < optional-fields.length
            if optional-fields[optional-index] == field
                optional = true
            optional-index = optional-index + 1
        defaulted bool = false
        default-index int = 0
        while default-index < default-fields.length
            if default-fields[default-index] == field
                defaulted = true
            default-index = default-index + 1
        if field != '' and not optional and not defaulted
            required.append; field
        index = index + 1
    return required

function decode-document document-result; value document-value, mapping document-mapping
    required = mapping-required-fields; mapping
    declared-fields list of string = list;
    field-index int = 0
    while field-index < mapping.field-names.length
        if mapping.field-names[field-index] != ''
            declared-fields.append; mapping.field-names[field-index]
        field-index = field-index + 1
    default-fields list of string = list;
    default-values list of string = list;
    default-index int = 0
    while default-index < mapping.default-fields.length and default-index < mapping.default-values.length
        if mapping.default-fields[default-index] != ''
            default-fields.append; mapping.default-fields[default-index]
            default-values.append; mapping.default-values[default-index]
        default-index = default-index + 1
    raw = validate-mapping; value.raw, mapping.expected-kind, required, declared-fields, default-fields, default-values, mapping.allow-unknown
    result = make-document-result; raw
    if result.failed
        result.expected = mapping.descriptor-name
    return result
