namespace standard/codecs

from /core/types import bool, string, bytes
from /core/platform-capabilities import hex-encode, hex-decode, base64-encode, base64-decode
from /core/platform-capabilities import result-failed, result-message, result-bytes

class decode-result
    failed bool = false
    message string = ''
    value bytes = b''

    function construct; failed bool, message string, data bytes
        this.failed = failed
        this.message = message
        this.value = data

class hex-codec
    function encode string; data bytes
        return hex-encode; data

    function decode decode-result; text string
        raw = hex-decode; text
        return decode-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)

class base64-codec
    url-safe bool = false

    function construct; url-safe bool
        this.url-safe = url-safe

    function encode string; data bytes, padded bool
        return base64-encode; data, this.url-safe, padded

    function decode decode-result; text string, padded bool
        raw = base64-decode; text, this.url-safe, padded
        return decode-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)

function hex hex-codec;
    return hex-codec;

function base64 base64-codec;
    return base64-codec; false

function base64-url base64-codec;
    return base64-codec; true

function encode-hex string; data bytes
    return hex-encode; data

function decode-hex decode-result; text string
    raw = hex-decode; text
    return decode-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)

function encode-base64 string; data bytes, url-safe bool, padded bool
    return base64-encode; data, url-safe, padded

function decode-base64 decode-result; text string, url-safe bool, padded bool
    raw = base64-decode; text, url-safe, padded
    return decode-result; (result-failed; raw), (result-message; raw), (result-bytes; raw)
