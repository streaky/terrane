namespace standard/filesystem

from /core/types import int, bool, string, bytes
from /standard/paths import path
from /core/platform-system import filesystem-exists as platform-filesystem-exists
from /core/platform-system import filesystem-metadata as platform-filesystem-metadata
from /core/platform-system import filesystem-realpath as platform-filesystem-realpath
from /core/platform-system import filesystem-read-link as platform-filesystem-read-link
from /core/platform-system import filesystem-read-bounded as platform-filesystem-read-bounded
from /core/platform-system import filesystem-write-atomic as platform-filesystem-write-atomic
from /core/platform-system import filesystem-rename as platform-filesystem-rename
from /core/platform-system import filesystem-remove as platform-filesystem-remove
from /core/platform-system import result-failed, result-message
from /core/platform-system import result-text, result-detail, result-bytes, result-int, result-bool
from /core/platform-system import filesystem-authority, acquire-filesystem-authority
from /core/platform-streams import resource-handle, open-file as platform-open-file
from /core/platform-streams import open-directory-beneath as platform-open-directory-beneath
from /core/platform-streams import open-file-beneath as platform-open-file-beneath
from /core/platform-streams import read as platform-read, write as platform-write
from /core/platform-streams import flush as platform-flush, sync-data as platform-sync-data
from /core/platform-streams import sync-all as platform-sync-all, close as platform-close
from /core/platform-streams import release as platform-release

class operation-result
    failed bool = false
    message string = ''

    function construct; failure bool, detail string
        this.failed = failure
        this.message = detail

class existence-result
    exists bool = false
    failed bool = false
    message string = ''

    function construct; exists bool, failure bool, detail string
        this.exists = exists
        this.failed = failure
        this.message = detail

class path-result
    resolved path = path; ''
    failed bool = false
    message string = ''

    function construct; target path, failure bool, detail string
        this.resolved = target
        this.failed = failure
        this.message = detail

class file-metadata
    kind string = 'other'
    size int = 0
    readonly bool = false
    permission-detail string = ''
    failed bool = false
    message string = ''

    function construct; kind string, size int, readonly bool, permission-detail string, failure bool, detail string
        this.kind = kind
        this.size = size
        this.readonly = readonly
        this.permission-detail = permission-detail
        this.failed = failure
        this.message = detail

class file-data
    data bytes = b''
    completed int = 0
    end bool = false
    failed bool = false
    message string = ''

    function construct; data bytes, completed int, end bool, failure bool, detail string
        this.data = data
        this.completed = completed
        this.end = end
        this.failed = failure
        this.message = detail

class file-handle
    handle resource-handle
    failed bool = false
    message string = ''

    function construct; raw resource-handle, failure bool, detail string
        this.handle = raw
        this.failed = failure
        this.message = detail

    function destruct;
        platform-release; this.handle

class directory-handle
    handle resource-handle
    failed bool = false
    message string = ''

    function construct; raw resource-handle, failure bool, detail string
        this.handle = raw
        this.failed = failure
        this.message = detail

    function destruct;
        platform-release; this.handle

function open-file file-handle; capability filesystem, target path, readable bool, writable bool, create bool = false, truncate bool = false
    raw = platform-open-file; target.text, readable, writable, create, truncate
    failure = raw.failed
    detail = raw.message
    acquired resource-handle = raw.handle
    return file-handle; acquired, failure, detail

function file-read file-data; capability filesystem, file ref file-handle, limit int
    raw = platform-read; file.handle, limit
    return file-data; raw.data, raw.completed, raw.end, raw.failed, raw.message

function file-write file-data; capability filesystem, file ref file-handle, data bytes, offset int = 0
    raw = platform-write; file.handle, data, offset
    return file-data; data, raw.completed, false, raw.failed, raw.message

function file-flush operation-result; capability filesystem, file ref file-handle
    raw = platform-flush; file.handle
    return operation-result; raw.failed, raw.message

function file-sync-data operation-result; capability filesystem, file ref file-handle
    raw = platform-sync-data; file.handle
    return operation-result; raw.failed, raw.message

function file-sync-all operation-result; capability filesystem, file ref file-handle
    raw = platform-sync-all; file.handle
    return operation-result; raw.failed, raw.message

function file-close operation-result; capability filesystem, file file-handle
    raw = platform-close; file.handle
    return operation-result; raw.failed, raw.message

class filesystem
    authority filesystem-authority

    function construct; authority filesystem-authority
        this.authority = authority

function filesystem-capability filesystem;
    authority = acquire-filesystem-authority;
    return filesystem; authority

function filesystem-exists existence-result; capability filesystem, target path
    record = platform-filesystem-exists; target.text
    return existence-result; (result-bool; record), (result-failed; record), (result-message; record)

function filesystem-metadata file-metadata; capability filesystem, target path
    record = platform-filesystem-metadata; target.text, true
    return file-metadata; (result-text; record), (result-int; record), (result-bool; record), (result-detail; record), (result-failed; record), (result-message; record)

function filesystem-symlink-metadata file-metadata; capability filesystem, target path
    record = platform-filesystem-metadata; target.text, false
    return file-metadata; (result-text; record), (result-int; record), (result-bool; record), (result-detail; record), (result-failed; record), (result-message; record)

function filesystem-realpath path-result; capability filesystem, target path
    record = platform-filesystem-realpath; target.text
    resolved = path; (result-text; record)
    return path-result; resolved, (result-failed; record), (result-message; record)

function filesystem-read-link path-result; capability filesystem, target path
    record = platform-filesystem-read-link; target.text
    linked = path; (result-text; record)
    return path-result; linked, (result-failed; record), (result-message; record)

function filesystem-open-beneath directory-handle; capability filesystem, directory path, relative path, cross-filesystem bool = false
    raw = platform-open-directory-beneath; directory.text, relative.text, cross-filesystem
    failure = raw.failed
    detail = raw.message
    acquired resource-handle = raw.handle
    return directory-handle; acquired, failure, detail

function open-file-beneath file-handle; capability filesystem, directory ref directory-handle, relative path, readable bool, writable bool, create bool = false, truncate bool = false
    raw = platform-open-file-beneath; directory.handle, relative.text, readable, writable, create, truncate
    failure = raw.failed
    detail = raw.message
    acquired resource-handle = raw.handle
    return file-handle; acquired, failure, detail

function filesystem-read-bounded file-data; capability filesystem, target path, limit int
    record = platform-filesystem-read-bounded; target.text, limit
    return file-data; (result-bytes; record), (result-int; record), true, (result-failed; record), (result-message; record)

function filesystem-write-atomic operation-result; capability filesystem, target path, data bytes
    record = platform-filesystem-write-atomic; target.text, data
    return operation-result; (result-failed; record), (result-message; record)

function filesystem-rename operation-result; capability filesystem, source path, destination path
    record = platform-filesystem-rename; source.text, destination.text
    return operation-result; (result-failed; record), (result-message; record)

function filesystem-remove operation-result; capability filesystem, target path
    record = platform-filesystem-remove; target.text
    return operation-result; (result-failed; record), (result-message; record)
