namespace standard/networking

from /core/types import int, bool, string, bytes
from /core/collections import list
from /core/platform-capabilities import platform-resource-handle, platform-capability
from /core/platform-capabilities import parse-ip, parse-host-name as platform-parse-host-name, parse-socket, tcp-bind, tcp-connect, tcp-connect-host, tcp-accept
from /core/platform-capabilities import tcp-read, tcp-write, tcp-shutdown, tcp-configure, udp-bind, udp-send-to, udp-receive-from, udp-configure
from /core/platform-capabilities import cancellation-token as platform-cancellation-token, cancel as platform-cancel, dns-lookup, close as platform-close
from /core/platform-capabilities import result-failed, result-truncated, result-deadline-exceeded, result-message, result-text, result-detail
from /core/platform-capabilities import result-bytes, result-int, result-bool, result-entries, result-resource

class operation-result
    failed bool = false
    message string = ''

    function construct; failed bool, message string
        this.failed = failed
        this.message = message
class cancellation-token
    handle platform-capability = platform-cancellation-token;


function cancel-operation operation-result; cancellation cancellation-token
    raw = platform-cancel; cancellation.handle
    return operation-result; (result-failed; raw), (result-message; raw)

class operation-options
    deadline-ms int = 30000
    cancellation cancellation-token = cancellation-token;

    function construct; deadline-ms int, cancellation cancellation-token
        this.deadline-ms = deadline-ms
        this.cancellation = cancellation


function operation-cancellation platform-capability; options operation-options
    return options.cancellation.handle
class tcp-options
    no-delay bool = true
    ttl int = 64

    function construct; no-delay bool, ttl int
        this.no-delay = no-delay
        this.ttl = ttl

class udp-options
    broadcast bool = false
    ttl int = 64

    function construct; broadcast bool, ttl int
        this.broadcast = broadcast
        this.ttl = ttl


class ip-address
    value string = ''
    version string = ''
    is-loopback bool = false

    function construct; text string, version string, is-loopback bool
        this.value = text
        this.version = version
        this.is-loopback = is-loopback

    function string string;
        return this.value

class ip-result
    failed bool = false
    message string = ''
    value ip-address = ip-address; '', '', false

    function construct; failed bool, message string, address ip-address
        this.failed = failed
        this.message = message
        this.value = address

function ip-address-from-string ip-result; text string
    raw = parse-ip; text
    return ip-result; (result-failed; raw), (result-message; raw), (ip-address; (result-text; raw), (result-detail; raw), (result-bool; raw))

class socket-address
    value string = ''
    ip ip-address = ip-address; '', '', false
    port int = 0

    function string string;
        return this.value

class socket-result
    failed bool = false
    message string = ''
    value socket-address = socket-address;

    function construct; failed bool, message string, address socket-address
        this.failed = failed
        this.message = message
        this.value = address

function socket-address-from-ip socket-result; ip ip-address, port int
    raw = parse-socket; ip.value, port
    address = socket-address;
    if not (result-failed; raw)
        address.value = result-text; raw
        address.ip = ip
        address.port = port
    return socket-result; (result-failed; raw), (result-message; raw), address

class io-result
    failed bool = false
    truncated bool = false
    deadline-exceeded bool = false
    message string = ''
    data bytes = b''
    completed int = 0
    peer string = ''
    end bool = false

    function construct; failed bool, truncated bool, deadline-exceeded bool, message string, data bytes, completed int, peer string, end bool
        this.failed = failed
        this.truncated = truncated
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.data = data
        this.completed = completed
        this.peer = peer
        this.end = end

class tcp-stream
    handle platform-resource-handle

    function read io-result; limit int, options operation-options
        raw = tcp-read; this.handle, limit, options.deadline-ms, options.cancellation.handle
        return io-result; (result-failed; raw), false, (result-deadline-exceeded; raw), (result-message; raw), (result-bytes; raw), (result-int; raw), '', (result-bool; raw)

    function write io-result; data bytes, options operation-options
        raw = tcp-write; this.handle, data, options.deadline-ms, options.cancellation.handle
        return io-result; (result-failed; raw), false, (result-deadline-exceeded; raw), (result-message; raw), b'', (result-int; raw), '', false

    function configure operation-result; options tcp-options
        raw = tcp-configure; this.handle, options.no-delay, options.ttl
        return operation-result; (result-failed; raw), (result-message; raw)

    function shutdown operation-result; direction string
        raw = tcp-shutdown; this.handle, direction
        return operation-result; (result-failed; raw), (result-message; raw)

    function close operation-result;
        raw = platform-close; this.handle
        return operation-result; (result-failed; raw), (result-message; raw)

    function destruct;
        platform-close; this.handle

class stream-result
    failed bool = false
    message string = ''
    peer string = ''
    value tcp-stream = tcp-stream;

    function construct; failed bool, message string, peer string, stream tcp-stream
        this.failed = failed
        this.message = message
        this.peer = peer
        this.value = stream

function connect-tcp stream-result; address socket-address, options operation-options
    raw = tcp-connect; address.value, options.deadline-ms, options.cancellation.handle
    stream = tcp-stream;
    if not (result-failed; raw)
        stream.handle = result-resource; raw
    return stream-result; (result-failed; raw), (result-message; raw), '', stream

function connect-host stream-result; host host-name, port int, options operation-options
    raw = tcp-connect-host; host.value, port, options.deadline-ms, options.cancellation.handle
    stream = tcp-stream;
    if not (result-failed; raw)
        stream.handle = result-resource; raw
    return stream-result; (result-failed; raw), (result-message; raw), (result-text; raw), stream

class tcp-listener
    handle platform-resource-handle
    local-address string = ''

    function accept stream-result; options operation-options
        raw = tcp-accept; this.handle, options.deadline-ms, options.cancellation.handle
        stream = tcp-stream;
        if not (result-failed; raw)
            stream.handle = result-resource; raw
        return stream-result; (result-failed; raw), (result-message; raw), (result-text; raw), stream

    function close operation-result;
        raw = platform-close; this.handle
        return operation-result; (result-failed; raw), (result-message; raw)

    function destruct;
        platform-close; this.handle

class listener-result
    failed bool = false
    message string = ''
    value tcp-listener = tcp-listener;

    function construct; failed bool, message string, listener tcp-listener
        this.failed = failed
        this.message = message
        this.value = listener

function bind-tcp listener-result; address socket-address
    raw = tcp-bind; address.value
    listener = tcp-listener;
    if not (result-failed; raw)
        listener.handle = result-resource; raw
        listener.local-address = result-text; raw
    return listener-result; (result-failed; raw), (result-message; raw), listener

class udp-socket
    handle platform-resource-handle
    local-address string = ''

    function send-to io-result; data bytes, address socket-address, options operation-options
        raw = udp-send-to; this.handle, data, address.value, options.deadline-ms, options.cancellation.handle
        return io-result; (result-failed; raw), false, (result-deadline-exceeded; raw), (result-message; raw), b'', (result-int; raw), '', false

    function receive-from io-result; limit int, options operation-options
        raw = udp-receive-from; this.handle, limit, options.deadline-ms, options.cancellation.handle
        return io-result; (result-failed; raw), (result-truncated; raw), (result-deadline-exceeded; raw), (result-message; raw), (result-bytes; raw), (result-int; raw), (result-text; raw), false

    function configure operation-result; options udp-options
        raw = udp-configure; this.handle, options.broadcast, options.ttl
        return operation-result; (result-failed; raw), (result-message; raw)

    function close operation-result;
        raw = platform-close; this.handle
        return operation-result; (result-failed; raw), (result-message; raw)

    function destruct;
        platform-close; this.handle

class udp-result
    failed bool = false
    message string = ''
    value udp-socket = udp-socket;

    function construct; failed bool, message string, socket udp-socket
        this.failed = failed
        this.message = message
        this.value = socket

function bind-udp udp-result; address socket-address
    raw = udp-bind; address.value
    socket = udp-socket;
    if not (result-failed; raw)
        socket.handle = result-resource; raw
        socket.local-address = result-text; raw
    return udp-result; (result-failed; raw), (result-message; raw), socket

class dns-result
    failed bool = false
    message string = ''
    candidates list of string = list; ''
    ttl int = 0
    ttl-known bool = false

    function construct; failed bool, message string, ttl int, ttl-known bool, candidates list of string
        this.failed = failed
        this.message = message
        this.ttl = ttl
        this.ttl-known = ttl-known
        this.candidates = candidates

class host-name
    value string = ''

class host-name-result
    failed bool = false
    message string = ''
    value host-name = host-name;

    function construct; failed bool, message string, host host-name
        this.failed = failed
        this.message = message
        this.value = host

function parse-host-name host-name-result; text string
    raw = platform-parse-host-name; text
    host = host-name;
    if not (result-failed; raw)
        host.value = result-text; raw
    return host-name-result; (result-failed; raw), (result-message; raw), host

function lookup-dns dns-result; host host-name, port int, options operation-options
    raw = dns-lookup; host.value, port, options.deadline-ms, options.cancellation.handle
    raw-candidates = result-entries; raw
    candidates list of string = list; ''
    index int = 0
    while index < raw-candidates.length
        candidates.append; raw-candidates[index]
        index = index + 1
    return dns-result; (result-failed; raw), (result-message; raw), (result-int; raw), (result-bool; raw), candidates
