namespace core/testing

from /core/errors import throwable
from /core/collections import list
from /core/process import arguments, environment, environment-entry, native-string
from /core/time import duration, invalid-duration

interface test-value
    function render string;

class test-failure implements throwable
    message string = ''
    assertion-source string = ''
    details list of string = list

    function construct; failure-message string
        this.message = failure-message

    function render string;
        return this.message

class test-skip implements throwable
    message string = ''
    assertion-source string = ''
    details list of string = list

    function construct; reason string
        this.message = reason

    function render string;
        return this.message

class test-infrastructure-failure implements throwable
    message string = ''

    function construct; failure-message string
        this.message = failure-message

    function render string;
        return this.message

function fail none throws test-failure; message string
    throw instance test-failure; message

function skip none throws test-skip; reason string
    throw instance test-skip; reason

function assert none throws test-failure; condition bool
    if not condition
        fail; 'assertion was false'
    return none

function deny none throws test-failure; condition bool
    if condition
        fail; 'denied condition was true'
    return none

private function fail-comparison none throws test-failure; failure-message string, actual string, expected string
    details list of string = list
    details.append; ('actual: '.concat; actual)
    details.append; ('expected: '.concat; expected)
    failure test-failure = instance test-failure; failure-message
    failure.details = details
    throw failure

function fail-values none throws test-failure; failure-message string, actual test-value, expected test-value
    fail-comparison; failure-message, (actual.render;), (expected.render;)
    return none

private function fail-near none throws test-failure; actual float64, expected float64, tolerance float64
    details list of string = list
    details.append; ('actual: '.concat; (host-test-render-float64; actual))
    details.append; ('expected: '.concat; (host-test-render-float64; expected))
    details.append; ('tolerance: '.concat; (host-test-render-float64; tolerance))
    failure test-failure = instance test-failure; 'floating values differ beyond tolerance'
    failure.details = details
    throw failure

function assert-equal-int none throws test-failure; actual int, expected int
    if actual != expected
        fail-comparison; 'integer values differ', (host-test-render-int; actual), (host-test-render-int; expected)
    return none

function assert-not-equal-int none throws test-failure; actual int, expected int
    if actual == expected
        fail-comparison; 'integer values unexpectedly match', (host-test-render-int; actual), (host-test-render-int; expected)
    return none

function assert-equal-string none throws test-failure; actual string, expected string
    if actual != expected
        fail-comparison; 'string values differ', actual, expected
    return none

function assert-not-equal-string none throws test-failure; actual string, expected string
    if actual == expected
        fail-comparison; 'string values unexpectedly match', actual, expected
    return none

function assert-equal-bool none throws test-failure; actual bool, expected bool
    if actual != expected
        fail-comparison; 'boolean values differ', (host-test-render-bool; actual), (host-test-render-bool; expected)
    return none

function assert-not-equal-bool none throws test-failure; actual bool, expected bool
    if actual == expected
        fail-comparison; 'boolean values unexpectedly match', (host-test-render-bool; actual), (host-test-render-bool; expected)
    return none

function assert-equal-float64 none throws test-failure; actual float64, expected float64
    if actual != expected
        fail-comparison; 'floating values differ', (host-test-render-float64; actual), (host-test-render-float64; expected)
    return none

function assert-not-equal-float64 none throws test-failure; actual float64, expected float64
    if actual == expected
        fail-comparison; 'floating values unexpectedly match', (host-test-render-float64; actual), (host-test-render-float64; expected)
    return none

function assert-equal-bytes none throws test-failure; actual bytes, expected bytes
    if actual != expected
        fail-comparison; 'byte values differ', (host-test-render-bytes; actual), (host-test-render-bytes; expected)
    return none

function assert-not-equal-bytes none throws test-failure; actual bytes, expected bytes
    if actual == expected
        fail-comparison; 'byte values unexpectedly match', (host-test-render-bytes; actual), (host-test-render-bytes; expected)
    return none

function assert-present-int none throws test-failure; actual int|none
    if actual == none
        fail; 'expected a present integer'
    return none

function assert-none-int none throws test-failure; actual int|none
    if actual != none
        fail; 'expected no integer'
    return none

function assert-present-string none throws test-failure; actual string|none
    if actual == none
        fail; 'expected a present string'
    return none

function assert-none-string none throws test-failure; actual string|none
    if actual != none
        fail; 'expected no string'
    return none

function assert-present-bool none throws test-failure; actual bool|none
    if actual == none
        fail; 'expected a present boolean'
    return none

function assert-none-bool none throws test-failure; actual bool|none
    if actual != none
        fail; 'expected no boolean'
    return none

function assert-present-float64 none throws test-failure; actual float64|none
    if actual == none
        fail; 'expected a present floating value'
    return none

function assert-none-float64 none throws test-failure; actual float64|none
    if actual != none
        fail; 'expected no floating value'
    return none

function assert-present-bytes none throws test-failure; actual bytes|none
    if actual == none
        fail; 'expected present bytes'
    return none

function assert-none-bytes none throws test-failure; actual bytes|none
    if actual != none
        fail; 'expected no bytes'
    return none

function assert-near none throws test-failure; actual float64, expected float64, tolerance float64
    if tolerance < 0.0
        fail; ('near-equality tolerance must not be negative: '.concat; (host-test-render-float64; tolerance))
    difference = actual - expected
    if difference < 0.0
        difference = 0.0 - difference
    if difference > tolerance
        fail-near; actual, expected, tolerance
    return none

function assert-throws none throws test-failure; operation function to none throws throwable, expected-descriptor string
    try
        operation;
    catch throwable as error
        if error.descriptor == expected-descriptor
            return none
        fail; ('expected throwable descriptor '.concat; expected-descriptor, ' but received ', error.descriptor)
    fail; ('expected callback to throw '.concat; expected-descriptor)
    return none

function context-value string|none; name string
    for entry in environment;
        if entry.name.is-text and entry.value.is-text and entry.name.text == name

            return entry.value.text
    return none
function test-arguments list of native-string;
    supplied = arguments;
    controlled list of native-string = list
    index int = 1
    while index < supplied.length
        controlled.append; supplied[index]
        index = index + 1
    return controlled

function test-deadline duration throws invalid-duration;
    return duration::nanoseconds; (host-test-deadline-nanoseconds;)

function temporary-directory string|none;
    return context-value; 'TMPDIR'

function deterministic-seed string|none;
    return context-value; 'TERRANE_TEST_SEED'

function test-identity string|none;
    return context-value; 'TERRANE_TEST_ID'

function application-artifact string|none;
    return context-value; 'TERRANE_TEST_ARTIFACT'

function test-tier string|none;
    return context-value; 'TERRANE_TEST_TIER'


function advance-time none throws test-failure; nanoseconds int
    if nanoseconds < 0
        fail; 'controlled time may only advance'
    if not (host-test-time-advance; nanoseconds)
        fail; 'controlled time advance exceeds the host clock range'
    return none
