namespace core/streams

from /core/encodings import utf8
from /core/errors import decode-error

class stream-operation-result
    failed bool = false
    message string = ''

    function construct; failed bool, message string
        this.failed = failed
        this.message = message

class read-result
    data bytes = b''
    completed int = 0
    end bool = false
    failed bool = false
    message string = ''

    function construct; data bytes, completed int, end bool, failed bool, message string
        this.data = data
        this.completed = completed
        this.end = end
        this.failed = failed
        this.message = message

class text-read-result
    text string = ''
    completed int = 0
    end bool = false
    failed bool = false
    message string = ''

    function construct; text string, completed int, end bool, failed bool, message string
        this.text = text
        this.completed = completed
        this.end = end
        this.failed = failed
        this.message = message

class write-result
    data bytes = b''
    completed int = 0
    failed bool = false
    message string = ''

    function construct; data bytes, completed int, failed bool, message string
        if completed == data.length and not failed
            this.data = b''
        else
            this.data = data
        this.completed = completed
        this.failed = failed
        this.message = message

class byte-reader
    private handle host-resource-handle

    private function construct; handle host-resource-handle
        this.handle = handle

    function read read-result; count int
        raw = host-read; this.handle, count
        return read-result; raw.data, raw.completed, raw.end, raw.failed, raw.message

    function read-exact read-result; count int
        data bytes = b''
        completed int = 0
        end bool = false
        failed bool = false
        message string = ''
        while completed < count and not end and not failed
            part = host-read; this.handle, count - completed
            data = data.concat; part.data
            completed = completed + part.completed
            end = part.end
            failed = part.failed
            message = part.message
            if part.completed == 0 and not part.end and not part.failed
                failed = true
                message = 'stream read made no progress'
        if end and completed < count and not failed
            failed = true
            message = 'stream ended before exact byte count'
        return read-result; data, completed, end, failed, message

    function read-all read-result; limit int
        data bytes = b''
        completed int = 0
        end bool = false
        failed bool = false
        message string = ''
        while completed < limit and not end and not failed
            part = host-read; this.handle, limit - completed
            data = data.concat; part.data
            completed = completed + part.completed
            end = part.end
            failed = part.failed
            message = part.message
            if part.completed == 0 and not part.end and not part.failed
                failed = true
                message = 'stream read made no progress'
        return read-result; data, completed, end, failed, message

    async function read-async read-result; count int
        return this.read; count

    function text text-reader; codec encoding
        return text-reader; this.handle, codec

    function close stream-operation-result;
        raw = host-close; this.handle
        return stream-operation-result; raw.failed, raw.message

    function destruct;
        # Destruction cannot report failure; explicit close is the observable failure path.
        host-release; this.handle

class byte-writer
    private handle host-resource-handle

    private function construct; handle host-resource-handle
        this.handle = handle

    function write write-result; data bytes
        offset int = 0
        raw = host-write; this.handle, data, offset
        return write-result; data, raw.completed, raw.failed, raw.message

    function write-all write-result; data bytes
        completed int = 0
        failed bool = false
        message string = ''
        while completed < data.length and not failed
            part = host-write; this.handle, data, completed
            completed = completed + part.completed
            failed = part.failed
            message = part.message
            if part.completed == 0 and not part.failed
                failed = true
                message = 'stream write made no progress'
        return write-result; data, completed, failed, message

    function resume write-result; prior write-result
        if prior.data.length == 0
            return prior
        raw = host-write; this.handle, prior.data, prior.completed
        return write-result; prior.data, prior.completed + raw.completed, raw.failed, raw.message

    async function write-async write-result; data bytes
        return this.write; data

    function text text-writer; codec encoding
        return text-writer; this.handle, codec

    function flush stream-operation-result;
        raw = host-flush; this.handle
        return stream-operation-result; raw.failed, raw.message

    function sync-data stream-operation-result;
        raw = host-sync-data; this.handle
        return stream-operation-result; raw.failed, raw.message

    function sync-all stream-operation-result;
        raw = host-sync-all; this.handle
        return stream-operation-result; raw.failed, raw.message

    function close stream-operation-result;
        raw = host-close; this.handle
        return stream-operation-result; raw.failed, raw.message

    function destruct;
        # Destruction cannot report failure; explicit close is the observable failure path.
        host-release; this.handle

class text-reader
    private handle host-resource-handle
    codec encoding = utf8

    private function construct; handle host-resource-handle, codec encoding
        this.handle = handle
        this.codec = codec

    function read text-read-result throws decode-error; count int
        raw = host-read; this.handle, count
        text string = raw.data.decode; this.codec
        return text-read-result; text, raw.completed, raw.end, raw.failed, raw.message

    function read-exact text-read-result throws decode-error; count int
        data bytes = b''
        completed int = 0
        end bool = false
        failed bool = false
        message string = ''
        while completed < count and not end and not failed
            part = host-read; this.handle, count - completed
            data = data.concat; part.data
            completed = completed + part.completed
            end = part.end
            failed = part.failed
            message = part.message
            if part.completed == 0 and not part.end and not part.failed
                failed = true
                message = 'stream read made no progress'
        if end and completed < count and not failed
            failed = true
            message = 'stream ended before exact byte count'
        text string = data.decode; this.codec
        return text-read-result; text, completed, end, failed, message

    function read-all text-read-result throws decode-error; limit int
        data bytes = b''
        completed int = 0
        end bool = false
        failed bool = false
        message string = ''
        while completed < limit and not end and not failed
            part = host-read; this.handle, limit - completed
            data = data.concat; part.data
            completed = completed + part.completed
            end = part.end
            failed = part.failed
            message = part.message
            if part.completed == 0 and not part.end and not part.failed
                failed = true
                message = 'stream read made no progress'
        text string = data.decode; this.codec
        return text-read-result; text, completed, end, failed, message

    async function read-async text-read-result throws decode-error; count int
        return this.read; count

    function close stream-operation-result;
        raw = host-close; this.handle
        return stream-operation-result; raw.failed, raw.message

    function destruct;
        # Destruction cannot report failure; explicit close is the observable failure path.
        host-release; this.handle

class text-writer
    private handle host-resource-handle
    codec encoding = utf8

    private function construct; handle host-resource-handle, codec encoding
        this.handle = handle
        this.codec = codec

    function write write-result; text string
        data bytes = text.encode; this.codec
        offset int = 0
        raw = host-write; this.handle, data, offset
        return write-result; data, raw.completed, raw.failed, raw.message
    function write-all write-result; text string
        data bytes = text.encode; this.codec
        completed int = 0
        failed bool = false
        message string = ''
        while completed < data.length and not failed
            part = host-write; this.handle, data, completed
            completed = completed + part.completed
            failed = part.failed
            message = part.message
            if part.completed == 0 and not part.failed
                failed = true
                message = 'stream write made no progress'
        return write-result; data, completed, failed, message

    function resume write-result; prior write-result
        if prior.data.length == 0
            return prior
        raw = host-write; this.handle, prior.data, prior.completed
        return write-result; prior.data, prior.completed + raw.completed, raw.failed, raw.message

    function line write-result; text string
        return this.write-all; (text.concat; '\n')

    async function write-async write-result; text string
        return this.write; text

    function flush stream-operation-result;
        raw = host-flush; this.handle
        return stream-operation-result; raw.failed, raw.message

    function sync-data stream-operation-result;
        raw = host-sync-data; this.handle
        return stream-operation-result; raw.failed, raw.message

    function sync-all stream-operation-result;
        raw = host-sync-all; this.handle
        return stream-operation-result; raw.failed, raw.message

    function close stream-operation-result;
        raw = host-close; this.handle
        return stream-operation-result; raw.failed, raw.message

    function destruct;
        # Destruction cannot report failure; explicit close is the observable failure path.
        host-release; this.handle

function stdin byte-reader;
    return byte-reader; (host-acquire-stdin;)

function stdout byte-writer;
    return byte-writer; (host-acquire-stdout;)

function stderr byte-writer;
    return byte-writer; (host-acquire-stderr;)
