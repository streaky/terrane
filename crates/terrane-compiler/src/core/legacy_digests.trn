namespace core/random/legacy-digests

from /core/random import hash-algorithm, digest-result, digest-bytes as modern-digest-bytes

function sha1 hash-algorithm;
  return instance hash-algorithm; 'sha-1'

function md5 hash-algorithm;
  return instance hash-algorithm; 'md5'

function digest-bytes digest-result; algorithm hash-algorithm, data bytes
  return modern-digest-bytes; algorithm, data
