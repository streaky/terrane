namespace core/networking/tls

from /core/networking import tcp-stream, network-operation-options, network-operation-result, io-result, network-host-name, operation-cancellation

class tls-stream
    private handle host-platform-resource-handle
    negotiated-version string = ''

    private function construct; resource host-platform-resource-handle
        this.handle = resource

    async function read io-result; limit int, options network-operation-options
        cancellation = operation-cancellation; options
        raw = await host-tls-read-async; this.handle, limit, options.deadline-ms, cancellation
        return instance io-result; (host-result-failed; raw), false, (host-result-deadline-exceeded; raw), (host-result-message; raw), (host-result-bytes; raw), (host-result-int; raw), '', (host-result-bool; raw)

    async function write io-result; data bytes, options network-operation-options
        cancellation = operation-cancellation; options
        raw = await host-tls-write-async; this.handle, data, options.deadline-ms, cancellation
        return instance io-result; (host-result-failed; raw), false, (host-result-deadline-exceeded; raw), (host-result-message; raw), b'', (host-result-int; raw), '', false

    function close network-operation-result;
        raw = host-close; this.handle
        return instance network-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    async function shutdown network-operation-result; options network-operation-options
        cancellation = operation-cancellation; options
        raw = await host-tls-shutdown-async; this.handle, options.deadline-ms, cancellation
        return instance network-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    function destruct;
        host-close; this.handle

class tls-result
    failed bool = false
    deadline-exceeded bool = false
    message string = ''
    value tls-stream = instance tls-stream; (host-no-resource;)

    function construct; failed bool, deadline-exceeded bool, message string, stream tls-stream
        this.failed = failed
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.value = stream

# Certificate-chain and hostname validation are unconditional on this ordinary connector.
# An insecure connector is intentionally absent; it can only live in a separately imported unsafe package.
async function connect-tls tls-result; stream tcp-stream, server-name network-host-name, options network-operation-options
    cancellation = operation-cancellation; options
    raw = await host-tls-client-async; stream.handle, server-name.value, options.deadline-ms, cancellation
    value = instance tls-stream; (host-result-resource; raw)
    if not (host-result-failed; raw)
        value.negotiated-version = host-result-text; raw
    return instance tls-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), value
