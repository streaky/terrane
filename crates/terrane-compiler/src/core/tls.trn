namespace core/networking/tls

from /core/networking import tcp-stream, network-host-name
from /core/networking/io import network-operation-result, network-operation-options, operation-cancellation, operation-deadline
from /core/streams import async-byte-reader, async-byte-writer, stream-operation-result, read-result, write-result, owned-read-buffer, buffered-read-result

class tls-stream implements async-byte-reader, async-byte-writer
    private handle host-platform-resource-handle
    negotiated-version string = ''

    private function construct; resource host-platform-resource-handle
        this.handle = resource

    async function read-async read-result; count int, options network-operation-options|none = none
        cancellation = operation-cancellation; options
        raw = await host-tls-read-async; this.handle, count, (operation-deadline; options), cancellation
        return instance read-result; (host-result-bytes; raw), (host-result-int; raw), (host-result-bool; raw), (host-result-failed; raw), (host-result-message; raw), (host-result-deadline-exceeded; raw)

    async function write-async write-result; data bytes, options network-operation-options|none = none
        cancellation = operation-cancellation; options
        raw = await host-tls-write-async; this.handle, data, 0, (operation-deadline; options), cancellation
        return instance write-result; data, (host-result-int; raw), (host-result-failed; raw), (host-result-message; raw), (host-result-deadline-exceeded; raw)

    async function read-into-async buffered-read-result; buffer owned-read-buffer, count int, options network-operation-options|none = none
        cancellation = operation-cancellation; options
        raw = await host-tls-read-into-async; this.handle, buffer.handle, count, (operation-deadline; options), cancellation
        buffer.completed = buffer.completed + (host-result-int; raw)
        return instance buffered-read-result; move buffer, (host-result-int; raw), (host-result-bool; raw), (host-result-failed; raw), (host-result-message; raw), (host-result-deadline-exceeded; raw)


    async function read-exact-async read-result; count int, options network-operation-options|none = none
        if count < 0
            return await this.read-async; count, options
        data bytes = b''
        completed int = 0
        end bool = false
        failed bool = false
        deadline-exceeded bool = false
        message string = ''
        while completed < count and not end and not failed and not deadline-exceeded
            part = await this.read-async; count - completed, options
            data = data.concat; part.data
            completed = completed + part.completed
            end = part.end
            failed = part.failed
            deadline-exceeded = part.deadline-exceeded
            message = part.message
            if part.completed == 0 and not part.end and not part.failed and not part.deadline-exceeded
                failed = true
                message = 'stream read made no progress'
        if end and completed < count and not failed and not deadline-exceeded
            failed = true
            message = 'stream ended before exact byte count'
        return instance read-result; data, completed, end, failed, message, deadline-exceeded

    async function write-all-async write-result; data bytes, options network-operation-options|none = none
        completed int = 0
        failed bool = false
        deadline-exceeded bool = false
        message string = ''
        while completed < data.length and not failed and not deadline-exceeded
            part = await host-tls-write-async; this.handle, data, completed, (operation-deadline; options), (operation-cancellation; options)
            completed = completed + (host-result-int; part)
            failed = host-result-failed; part
            deadline-exceeded = host-result-deadline-exceeded; part
            message = host-result-message; part
            if (host-result-int; part) == 0 and not failed and not deadline-exceeded
                failed = true
                message = 'stream write made no progress'
        return instance write-result; data, completed, failed, message, deadline-exceeded

    consuming function close stream-operation-result;
        raw = host-close; this.handle
        return instance stream-operation-result; (host-result-failed; raw), (host-result-message; raw), (host-result-deadline-exceeded; raw)

    async function shutdown network-operation-result; options network-operation-options|none = none
        cancellation = operation-cancellation; options
        raw = await host-tls-shutdown-async; this.handle, (operation-deadline; options), cancellation
        return instance network-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    consuming function destruct;
        host-close; this.handle

class tls-result
    failed bool = false
    deadline-exceeded bool = false
    message string = ''
    value tls-stream = instance tls-stream; (host-no-resource;)

    function construct; failed bool, deadline-exceeded bool, message string, stream tls-stream
        this.failed = failed
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.value = stream

# Certificate-chain and hostname validation are unconditional on this ordinary connector.
# An insecure connector is intentionally absent; it can only live in a separately imported unsafe package.
async function connect-tls tls-result; stream tcp-stream, server-name network-host-name, options network-operation-options|none = none
    cancellation = operation-cancellation; options
    raw = await host-tls-client-async; stream.handle, server-name.value, (operation-deadline; options), cancellation
    value = instance tls-stream; (host-result-resource; raw)
    if not (host-result-failed; raw)
        value.negotiated-version = host-result-text; raw
    return instance tls-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), value
