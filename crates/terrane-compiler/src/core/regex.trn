namespace core/regex

from /core/errors import throwable

class regex-error implements throwable
    message string = ''

    private function construct; detail string
        this.message = detail

    function render string;
        return this.message

class regex-match-error implements throwable
    message string = ''

    private function construct; detail string
        this.message = detail

    function render string;
        return this.message

class regex-captures
    private value host-regex-captures

    private function construct; value host-regex-captures
        this.value = value

    function group text-range|none; index int
        return host-capture; this.value, index

    function named-group text-range|none; name string
        return host-named-capture; this.value, name

class regex-pattern
    private value host-regex-pattern

    private function construct; value host-regex-pattern
        this.value = value

    function matches bool throws regex-match-error; text string
        result = host-matches; this.value, text
        check-match-error; (host-result-error; result)
        return host-result-value; move result

    function match text-range|none throws regex-match-error; text string
        result = host-first-match; this.value, text
        check-match-error; (host-result-error; result)
        return host-result-value; move result

    function captures regex-captures|none throws regex-match-error; text string
        result = host-captures; this.value, text
        check-match-error; (host-result-error; result)
        found = host-result-value; move result
        if found != none
            return instance regex-captures; found
        return none

private function check-match-error throws regex-match-error; detail string|none
    if detail != none
        throw instance regex-match-error; detail

function compile regex-pattern throws regex-error; pattern string, case-insensitive bool = false
    result = host-compile; pattern, case-insensitive
    detail = host-result-error; result
    if detail != none
        throw instance regex-error; move detail
    return instance regex-pattern; (host-result-value; move result)
