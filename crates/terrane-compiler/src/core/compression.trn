namespace core/compression


class compression-options
    level int = 6
    deterministic bool = true

    function construct; level int, deterministic bool
        this.level = level
        this.deterministic = deterministic

class decompression-limits
    max-output int = 16777216
    max-ratio int = 100
    max-work int = 67108864

    function construct; max-output int, max-ratio int, max-work int
        this.max-output = max-output
        this.max-ratio = max-ratio
        this.max-work = max-work

class compression-result
    failed bool = false
    resource-limit bool = false
    message string = ''
    value bytes = b''

    function construct; failed bool, resource-limit bool, message string, data bytes
        this.failed = failed
        this.resource-limit = resource-limit
        this.message = message
        this.value = data

class compression-codec
    format string = ''

    function construct; format string
        this.format = format

    function compress compression-result; data bytes, options compression-options
        format = this.format
        raw = host-compress; format, data, options.level, options.deterministic
        return instance compression-result; (host-result-failed; raw), (host-result-resource-limit; raw), (host-result-message; raw), (host-result-bytes; raw)

    function decompress compression-result; data bytes, limits decompression-limits
        format = this.format
        raw = host-decompress; format, data, limits.max-output, limits.max-ratio, limits.max-work
        return instance compression-result; (host-result-failed; raw), (host-result-resource-limit; raw), (host-result-message; raw), (host-result-bytes; raw)

function gzip compression-codec;
    return instance compression-codec; 'gzip'

function zlib compression-codec;
    return instance compression-codec; 'zlib'

function deflate-raw compression-codec;
    return instance compression-codec; 'deflate-raw'

function zstd compression-codec;
    return instance compression-codec; 'zstd'
