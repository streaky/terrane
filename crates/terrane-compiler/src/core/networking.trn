    backlog int = 128
    reuse-address bool = false
    accepted-no-delay bool = false
    accepted-ttl int = -1

    function construct; backlog int = 128, reuse-address bool = false, accepted-no-delay bool = false, accepted-ttl int = -1
        this.backlog = backlog
        this.reuse-address = reuse-address
        this.accepted-no-delay = accepted-no-delay
        this.accepted-ttl = accepted-ttl



class udp-options
    broadcast bool = false
