namespace core/networking

from /core/collections import list
from /core/streams import async-byte-reader, async-byte-writer, stream-operation-result, read-result, write-result, owned-read-buffer, buffered-read-result
from /core/streams import exact-read-progress, write-progress
from /core/io import cancellation-token, io-operation-options, io-operation-result, cancel-operation, operation-cancellation, operation-deadline

class tcp-options
    no-delay bool = false
    ttl int = -1

    function construct; no-delay bool = false, ttl int = -1
        this.no-delay = no-delay
        this.ttl = ttl

