    function construct; failed bool, truncated bool, deadline-exceeded bool, message string, data bytes, completed int, peer string
        this.failed = failed
        this.truncated = truncated
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.data = data
        this.completed = completed
        this.peer = peer

class udp-socket
    private handle host-platform-resource-handle

    private function construct; resource host-platform-resource-handle
        this.handle = resource
    local-address string = ''

    async function send-to datagram-io-result; data bytes, address socket-address, options io-operation-options|none = none
        operation-timeout = operation-deadline; options
        operation-token = operation-cancellation; options
        raw = await host-udp-send-to-async; this.handle, data, address.value, operation-timeout, operation-token
        return instance datagram-io-result; (host-result-failed; raw), false, (host-result-deadline-exceeded; raw), (host-result-message; raw), b'', (host-result-int; raw), ''

    async function receive-from datagram-io-result; limit int, options io-operation-options|none = none
        operation-timeout = operation-deadline; options
        operation-token = operation-cancellation; options
        raw = await host-udp-receive-from-async; this.handle, limit, operation-timeout, operation-token
        return instance datagram-io-result; (host-result-failed; raw), (host-result-truncated; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), (host-result-bytes; raw), (host-result-int; raw), (host-result-text; raw)

    function configure io-operation-result; options udp-options
        raw = host-udp-configure; this.handle, options.broadcast, options.ttl
        return instance io-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    consuming function close io-operation-result;
        raw = host-close; this.handle
        return instance io-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    consuming function destruct;
        host-close; this.handle

class udp-result
    failed bool = false
    deadline-exceeded bool = false
    message string = ''
    value udp-socket = instance udp-socket; (host-no-resource;)

    function construct; failed bool, deadline-exceeded bool, message string, socket udp-socket
        this.failed = failed
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.value = socket

function bind-udp udp-result; address socket-address
    raw = host-udp-bind; address.value
    socket = instance udp-socket; (host-result-resource; raw)
    if not (host-result-failed; raw)
        socket.local-address = host-result-text; raw
    return instance udp-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), socket

class dns-result
    failed bool = false
    deadline-exceeded bool = false
    message string = ''
    candidates list of string = list; ''
    ttl int = 0
    ttl-known bool = false

    function construct; failed bool, deadline-exceeded bool, message string, ttl int, ttl-known bool, candidates list of string
        this.failed = failed
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.ttl = ttl
        this.ttl-known = ttl-known
        this.candidates = candidates

class network-host-name
    value string = ''

    private function construct; raw host-platform-result
        this.value = host-result-text; raw

class network-host-name-result
    failed bool = false
    message string = ''
    value network-host-name = instance network-host-name; (host-failed-result;)

    function construct; failed bool, message string, host network-host-name
        this.failed = failed
        this.message = message
        this.value = host

function parse-host-name network-host-name-result; text string
    raw = host-parse-host-name; text
    failed = host-result-failed; raw
    message = host-result-message; raw
    host = instance network-host-name; raw
    return instance network-host-name-result; failed, message, host

async function lookup-dns dns-result; host network-host-name, port int, options io-operation-options|none = none
    operation-timeout = operation-deadline; options
    operation-token = operation-cancellation; options
    raw = await host-dns-lookup-async; host.value, port, operation-timeout, operation-token
    raw-candidates = host-result-entries; raw
    candidates list of string = list; ''
    index int = 0
    while index < raw-candidates.length
        candidates.append; raw-candidates[index]
        index = index + 1
    return instance dns-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), (host-result-int; raw), (host-result-bool; raw), candidates
