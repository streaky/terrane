    function construct; broadcast bool, ttl int
        this.broadcast = broadcast
        this.ttl = ttl


class ip-address
    value string = ''
    version string = ''
    is-loopback bool = false

    private function construct; raw host-platform-result
        this.value = host-result-text; raw
        this.version = host-result-detail; raw
        this.is-loopback = host-result-bool; raw

    function string string;
        return this.value

class ip-result
    failed bool = false
    message string = ''
    value ip-address = instance ip-address; (host-failed-result;)

    function construct; failed bool, message string, address ip-address
        this.failed = failed
        this.message = message
        this.value = address

function ip-address-from-string ip-result; text string
    raw = host-parse-ip; text
    failed = host-result-failed; raw
    message = host-result-message; raw
    return instance ip-result; failed, message, (instance ip-address; raw)

class socket-address
    value string = ''
    ip ip-address = instance ip-address; (host-failed-result;)
    port int = 0

    private function construct; raw host-platform-result, address-ip ip-address, address-port int
        this.value = host-result-text; raw
        this.ip = address-ip
        this.port = address-port

    function string string;
        return this.value

class socket-result
    failed bool = false
    message string = ''
    value socket-address = instance socket-address; (host-failed-result;), (instance ip-address; (host-failed-result;)), 0

    function construct; failed bool, message string, address socket-address
        this.failed = failed
        this.message = message
        this.value = address

function socket-address-from-ip socket-result; ip ip-address, port int
    raw = host-parse-socket; ip.value, port
    failed = host-result-failed; raw
    message = host-result-message; raw
    address = instance socket-address; raw, ip, port
    return instance socket-result; failed, message, address

function socket-address-from-string socket-result; text string
    raw = host-parse-socket-text; text
    failed = host-result-failed; raw
    message = host-result-message; raw
    address-ip = instance ip-address; (host-parse-ip; (host-result-detail; raw))
    port = host-result-int; raw
    address = instance socket-address; raw, address-ip, port
    return instance socket-result; failed, message, address

class tcp-stream implements async-byte-reader, async-byte-writer
    protected handle host-platform-resource-handle

    private function construct; resource host-platform-resource-handle
        this.handle = resource


    async function read-async read-result; count int, options io-operation-options|none = none
        operation-timeout = operation-deadline; options
        operation-token = operation-cancellation; options
        raw = await host-tcp-read-async; this.handle, count, operation-timeout, operation-token
        return instance read-result; (host-result-bytes; raw), (host-result-int; raw), (host-result-bool; raw), (host-result-failed; raw), (host-result-message; raw), (host-result-deadline-exceeded; raw)

    async function write-async write-result; data bytes, options io-operation-options|none = none
        operation-timeout = operation-deadline; options
        operation-token = operation-cancellation; options
        raw = await host-tcp-write-async; this.handle, data, 0, operation-timeout, operation-token
        return instance write-result; data, (host-result-int; raw), (host-result-failed; raw), (host-result-message; raw), (host-result-deadline-exceeded; raw)

    async function write-all-async write-result; data bytes, options io-operation-options|none = none
        progress = instance write-progress;
        while progress.pending; data.length
            operation-timeout = operation-deadline; options
            operation-token = operation-cancellation; options
            part = await host-tcp-write-async; this.handle, data, progress.completed, operation-timeout, operation-token
            progress.advance; (host-result-int; part), (host-result-failed; part), (host-result-deadline-exceeded; part), (host-result-message; part)
        return progress.result; move data


    async function read-exact-async read-result; count int, options io-operation-options|none = none
        if count < 0
            return await this.read-async; count, options
        progress = instance exact-read-progress; count
        data bytes = b''
        while progress.pending;
            part = await this.read-async; (progress.remaining;), options
            data = data.concat; part.data
            progress.advance; part.completed, part.end, part.failed, part.deadline-exceeded, part.message
        return progress.result; move data
    async function read-into-async buffered-read-result; buffer owned-read-buffer, count int, options io-operation-options|none = none
        operation-timeout = operation-deadline; options
        operation-token = operation-cancellation; options
        raw = await host-tcp-read-into-async; this.handle, buffer.handle, count, operation-timeout, operation-token
        completed = host-result-int; raw
        end = host-result-bool; raw
        failed = host-result-failed; raw
        message = host-result-message; raw
        deadline-exceeded = host-result-deadline-exceeded; raw
        return instance buffered-read-result; move buffer, completed, end, failed, message, deadline-exceeded

    function configure io-operation-result; options tcp-options
        raw = host-tcp-configure; this.handle, options.no-delay, options.ttl
        return instance io-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    function shutdown io-operation-result; direction string
        raw = host-tcp-shutdown; this.handle, direction
        return instance io-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    consuming function close stream-operation-result;
        raw = host-close; this.handle
        return instance stream-operation-result; (host-result-failed; raw), (host-result-message; raw), (host-result-deadline-exceeded; raw)

    consuming function destruct;
        host-close; this.handle


class stream-result
    failed bool = false
    deadline-exceeded bool = false
    message string = ''
    peer string = ''
    value tcp-stream = instance tcp-stream; (host-no-resource;)

    function construct; failed bool, deadline-exceeded bool, message string, peer string, stream tcp-stream
        this.failed = failed
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.peer = peer
        this.value = stream

async function connect-tcp stream-result; address socket-address, options io-operation-options|none = none, tcp tcp-options|none = none
    settings tcp-options
    if tcp != none
        settings = tcp
    else
        settings = instance tcp-options;
    operation-timeout = operation-deadline; options
    operation-token = operation-cancellation; options
    raw = await host-tcp-connect-async; address.value, settings.no-delay, settings.ttl, operation-timeout, operation-token
    stream = instance tcp-stream; (host-result-resource; raw)
    return instance stream-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), '', stream

async function connect-host stream-result; host network-host-name, port int, options io-operation-options|none = none, tcp tcp-options|none = none
    settings tcp-options
    if tcp != none
        settings = tcp
    else
        settings = instance tcp-options;
    operation-timeout = operation-deadline; options
    operation-token = operation-cancellation; options
    raw = await host-tcp-connect-host-async; host.value, port, settings.no-delay, settings.ttl, operation-timeout, operation-token
    stream = instance tcp-stream; (host-result-resource; raw)
    return instance stream-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), (host-result-text; raw), stream

class tcp-listener
    private handle host-platform-resource-handle

    private function construct; resource host-platform-resource-handle
        this.handle = resource
    local-address string = ''

    async function accept stream-result; options io-operation-options|none = none
        operation-timeout = operation-deadline; options
        operation-token = operation-cancellation; options
        raw = await host-tcp-accept-async; this.handle, operation-timeout, operation-token
        stream = instance tcp-stream; (host-result-resource; raw)
        return instance stream-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), (host-result-text; raw), stream

    consuming function close io-operation-result;
        raw = host-close; this.handle
        return instance io-operation-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw)

    consuming function destruct;
        host-close; this.handle

class listener-result
    failed bool = false
    deadline-exceeded bool = false
    message string = ''
    value tcp-listener = instance tcp-listener; (host-no-resource;)

    function construct; failed bool, deadline-exceeded bool, message string, listener tcp-listener
        this.failed = failed
        this.deadline-exceeded = deadline-exceeded
        this.message = message
        this.value = listener

function bind-tcp listener-result; address socket-address, options tcp-listener-options|none = none
    settings tcp-listener-options
    if options != none
        settings = options
    else
        settings = instance tcp-listener-options;
    raw = host-tcp-bind; address.value, settings.backlog, settings.reuse-address, settings.accepted-no-delay, settings.accepted-ttl
    listener = instance tcp-listener; (host-result-resource; raw)
    if not (host-result-failed; raw)
        listener.local-address = host-result-text; raw
    return instance listener-result; (host-result-failed; raw), (host-result-deadline-exceeded; raw), (host-result-message; raw), listener

class datagram-io-result
    failed bool = false
    truncated bool = false
    deadline-exceeded bool = false
    message string = ''
    data bytes = b''
