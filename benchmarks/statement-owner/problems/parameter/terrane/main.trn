namespace parameter-owner
from /core/process import arguments, exit, make-exit-status

class counter
    value int = 0

function assign; owner shared ref counter, amount int
    owner.value = amount

function main;
    supplied = arguments;
    if supplied.length != 1
        exit; (make-exit-status; 2)
    count int = supplied[0].text.radix; 10
    if count <= 0
        exit; (make-exit-status; 2)
    state = shared ref (instance counter;)
    checksum int = 0
    index int = 0
    while index < count
        amount = (index % 7) + 1
        assign; state, amount
        checksum = checksum + state.value
        index = index + 1
    print; checksum
