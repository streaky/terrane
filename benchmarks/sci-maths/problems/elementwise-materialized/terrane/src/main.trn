namespace benchmark-elementwise-materialized

from /core/output import print
from /core/collections import list
from /standard/process import platform-string, arguments

function main;
  supplied = (arguments;)
  count int64 = 1000
  if supplied.length > 0 and supplied[0].text == 'performance'
    count = 1000000

  transformed list of float64 = list
  index int64 = 0
  while index < count
    raw float64 = index % 1000
    x float64 = raw / 100
    transformed.append; x * x + 3 * x - 7
    index++

  total float64 = 0
  for value in transformed
    total = total + value

  print; total
