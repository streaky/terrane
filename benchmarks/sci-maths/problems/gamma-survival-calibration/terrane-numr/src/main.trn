namespace benchmark-gamma-survival-calibration

from /standard/process import platform-string, arguments, exit, make-exit-status
from /deps/numr/algorithm/special import gammaincc_scalar

function benchmark-size int64;
  supplied = (arguments;)
  if supplied.length != 1
    exit; (make-exit-status; 2)
  count int64 = (supplied[0].text.radix; 10)
  if count <= 0
    exit; (make-exit-status; 2)
  return count

function main;
  count int64 = (benchmark-size;)
  total float64 = 0
  index int64 = 0
  while index < count
    shape-part float64 = index % 17
    observation-part float64 = index % 101
    target-part float64 = index % 7
    shape float64 = 1.25 + shape-part * 0.125
    observation float64 = 0.5 + observation-part * 0.05
    target float64 = 0.2 + target-part * 0.1
    survival float64 = (gammaincc_scalar; shape, observation)
    residual float64 = survival - target
    total = total + residual * residual
    index++
  divisor float64 = count
  print; total / divisor
