namespace benchmark-collatz-branching

from /core/output import print
from /standard/process import platform-string, arguments

function main;
  supplied = (arguments;)
  limit int64 = 1000
  if supplied.length > 0 and supplied[0].text == 'performance'
    limit = 100000

  total int64 = 0
  start int64 = 1
  while start <= limit
    value int64 = start
    while value != 1
      if value % 2 == 0
        value = value / 2
      else
        value = 3 * value + 1
      total++
    start++

  print; total
