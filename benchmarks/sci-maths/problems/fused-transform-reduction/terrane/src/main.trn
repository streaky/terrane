namespace benchmark-fused-transform-reduction

from /core/output import print
from /standard/process import platform-string, arguments, exit, make-exit-status

function benchmark-size int64;
  supplied = (arguments;)
  if supplied.length != 1
    exit; (make-exit-status; 2)
  count int64 = (supplied[0].text.radix; 10)
  if count <= 0
    exit; (make-exit-status; 2)
  return count

function main;
  count int64 = (benchmark-size;)

  total float64 = 0
  index int64 = 0
  while index < count
    raw float64 = index % 1000
    x float64 = raw / 100
    square float64 = x * x
    total = total + (square + 3 * x - 7) / (1 + square)
    index++

  print; total
