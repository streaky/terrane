namespace benchmark-bessel-kernel-energy

from /core/output import print
from /standard/process import platform-string, arguments, exit, make-exit-status

function benchmark-size int64;
  supplied = (arguments;)
  if supplied.length != 1
    exit; (make-exit-status; 2)
  count int64 = (supplied[0].text.radix; 10)
  if count <= 0
    exit; (make-exit-status; 2)
  return count

function absolute float64; value float64
  if value < 0
    return 0.0 - value
  return value

function square-root float64; value float64
  if value == 0
    return 0
  estimate float64 = value
  if estimate < 1
    estimate = 1
  iteration int64 = 0
  while iteration < 12
    estimate = 0.5 * (estimate + value / estimate)
    iteration++
  return estimate

function reduced-angle float64; angle float64
  pi float64 = 3.14159265358979323846
  tau float64 = 6.28318530717958647692
  while angle > pi
    angle = angle - tau
  while angle < 0.0 - pi
    angle = angle + tau
  return angle

function sine float64; angle float64
  x float64 = (reduced-angle; angle)
  square float64 = x * x
  term float64 = x
  total float64 = x
  index int64 = 1
  while index < 14
    left float64 = 2 * index
    right float64 = left + 1
    term = (0.0 - term) * square / (left * right)
    total = total + term
    index++
  return total

function cosine float64; angle float64
  x float64 = (reduced-angle; angle)
  square float64 = x * x
  term float64 = 1
  total float64 = 1
  index int64 = 1
  while index < 14
    left float64 = 2 * index - 1
    right float64 = 2 * index
    term = (0.0 - term) * square / (left * right)
    total = total + term
    index++
  return total

function bessel-j0 float64; argument float64
  x float64 = (absolute; argument)
  if x < 8
    square float64 = x * x
    numerator float64 = 57568490574 + square * (0 - 13362590354 + square * (651619640.7 + square * (0.0 - 11214424.18 + square * (77392.33017 + square * (0.0 - 184.9052456)))))
    denominator float64 = 57568490411 + square * (1029532985 + square * (9494680.718 + square * (59272.64853 + square * (267.8532712 + square))))
    return numerator / denominator

  scale float64 = 8 / x
  square float64 = scale * scale
  phase float64 = x - 0.785398164
  numerator float64 = 1 + square * (0.0 - 0.001098628627 + square * (0.00002734510407 + square * (0.0 - 0.000002073370639 + square * 0.0000002093887211)))
  denominator float64 = 0.0 - 0.01562499995 + square * (0.0001430488765 + square * (0.0 - 0.000006911147651 + square * (0.0000007621095161 - square * 0.0000000934935152)))
  amplitude float64 = (square-root; 0.636619772 / x)
  return amplitude * ((cosine; phase) * numerator - scale * (sine; phase) * denominator)

function coordinate float64; index int64
  raw float64 = (index * 37) % 1009
  return raw / 1009

function main;
  count int64 = (benchmark-size;)
  total float64 = 0
  left-index int64 = 0
  while left-index < count
    left float64 = (coordinate; left-index)
    right-index int64 = 0
    while right-index < count
      right float64 = (coordinate; right-index)
      distance float64 = (absolute; left - right)
      argument float64 = 18 * distance
      value float64 = (bessel-j0; argument)
      total = total + value / (1 + 4 * distance * distance)
      right-index++
    left-index++
  pair-count float64 = count * count
  print; total / pair-count
