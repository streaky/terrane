namespace benchmark-scalar-reduction

from /core/output import print
from /standard/process import platform-string, arguments

function main;
  supplied = (arguments;)
  count int64 = 1000
  if supplied.length > 0 and supplied[0].text == 'performance'
    count = 50000000

  total int64 = 0
  index int64 = 0
  while index < count
    value int64 = (index % 1000) - 500
    total = total + value * value
    index++

  print; total
