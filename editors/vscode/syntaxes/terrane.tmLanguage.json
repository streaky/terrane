{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Terrane",
  "scopeName": "source.terrane",
  "patterns": [
    { "include": "#rust-block" },
    { "include": "#comments" },
    { "include": "#block-text" },
    { "include": "#tail-text" },
    { "include": "#quoted-text" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#literals" },
    { "include": "#contextual-keywords" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#lexical-tokens" }
  ],
  "repository": {
    "rust-block": {
      "name": "meta.rust-block.terrane",
      "comment": "Repeated inline comments must stop at their first terminator, never backtrack across later comments. Pipe and colon are separate lexer tokens, not compound-operator prefixes.",
      "begin": "^([ \\t]*)(?![ \\t]|>|return[ \\t]+>)(?:(?:(return)(?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)+)?(?:(unsafe)(?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)+)?(rust)|((?:'(?:[^'\\\\\\r\\n]|\\\\.)*'|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|/\\*(?:[^*]|\\*(?!/))*\\*/|/(?![/*])|(?![=;,(\\[{+*/%<>=!&^~-][ \\t]*>)[^'\"/#\\r\\n])*?(?<![+*/%<>=!&^~-])=(?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)*)(?:(unsafe)(?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)+)?(rust))((?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)*(?:(?://|#).*)?)$",
      "beginCaptures": {
        "2": { "name": "keyword.control.terrane" },
        "3": { "name": "keyword.control.terrane" },
        "4": { "name": "keyword.control.terrane" },
        "5": { "patterns": [{ "include": "$self" }] },
        "6": { "name": "keyword.control.terrane" },
        "7": { "name": "keyword.control.terrane" },
        "8": { "patterns": [{ "include": "#comments" }] }
      },
      "while": "^(?:\\1[ \\t]+|[ \\t]*$)",
      "contentName": "meta.embedded.block.rust",
      "patterns": [
        { "include": "source.rust" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.terrane",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.terrane",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.terrane",
          "match": "//.*$"
        }
      ]
    },
    "block-text": {
      "comment": "Expression starts follow lexer token kinds: Pipe and Colon are not Operator. Inline comment atoms cannot cross a closing delimiter.",
      "begin": "^([ \\t]*)(?![ \\t]|>(?!>)|return[ \\t]+>(?!>))(?:((?:(?:'(?:[^'\\\\\\r\\n]|\\\\.)*'|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|/\\*(?:[^*]|\\*(?!/))*\\*/|/(?![/*])|(?![=;,(\\[{+*/%<>=!&^~-][ \\t]*>)[^'\"/#\\r\\n])*?(?:[=;,(\\[{]|[+*/%<>=!&^~-])|return)(?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)*))?(>>)[ \\t]*$",
      "beginCaptures": {
        "2": { "patterns": [{ "include": "$self" }] },
        "3": { "name": "punctuation.definition.string.begin.terrane" }
      },
      "while": "^(?:\\1[ \\t]+|[ \\t]*$)",
      "contentName": "string.unquoted.block.terrane",
      "patterns": [
        { "include": "#escapes" }
      ]
    },
    "tail-text": {
      "comment": "Operators merge only doubled + - < > or a trailing =, not arbitrary runs. A single > can follow another operator without trivia; lexical fallback tokens protect joined identifiers and ++/-- from partial matches.",
      "match": "((?:^[ \\t]*(?:return(?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)+)?|[=;,(\\[{](?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)*|(?:<<|>>|[+*/%<>=!&^~@-]=?)(?:[ \\t]|/\\*(?:[^*]|\\*(?!/))*\\*/)+|(?:<<|>=|[+*/%<=!&^~@-]=?)))(>(?!>).*$)",
      "captures": {
        "1": { "patterns": [{ "include": "$self" }] },
        "2": { "name": "string.unquoted.tail.terrane" }
      }
    },
    "quoted-text": {
      "patterns": [
        { "include": "#byte-string" },
        { "include": "#single-string" },
        { "include": "#double-string" }
      ]
    },
    "single-string": {
      "name": "string.quoted.single.terrane",
      "begin": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.terrane" } },
      "end": "'|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.terrane" } },
      "patterns": [{ "include": "#single-escapes" }]
    },
    "byte-string": {
      "name": "string.quoted.single.terrane",
      "begin": "b'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.terrane" } },
      "end": "'|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.terrane" } },
      "patterns": [{ "include": "#byte-escapes" }]
    },
    "single-escapes": {
      "name": "constant.character.escape.terrane",
      "match": "\\\\[\\\\']"
    },
    "byte-escapes": {
      "name": "constant.character.escape.terrane",
      "match": "\\\\(?:[\\\\'nrt0]|x[0-9A-Fa-f]{2})"
    },
    "double-string": {
      "name": "string.quoted.double.terrane",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.terrane" } },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.terrane" } },
      "patterns": [
        { "include": "#double-escapes" },
        { "name": "constant.character.escape.terrane", "match": "\\{\\{" },
        { "name": "constant.character.escape.terrane", "match": "\\}\\}" },
        {
          "name": "meta.interpolation.terrane",
          "begin": "\\{(?!\\{)",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.terrane" } },
          "end": "\\}|$",
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.terrane" } },
          "patterns": [{ "include": "#interpolation-key" }, { "include": "$self" }]
        }
      ]
    },
    "double-escapes": {
      "name": "constant.character.escape.terrane",
      "match": "\\\\(?:[\\\\'\"nrt0]|u\\{[0-9A-Fa-f]+\\})"
    },
    "escapes": {
      "name": "constant.character.escape.terrane",
      "match": "\\\\(?:[\\\\'nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
    },
    "numbers": {
      "name": "constant.numeric.terrane",
      "match": "\\b(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?)\\b"
    },
    "annotations": {
      "match": "(@\\[)([A-Za-z_][A-Za-z0-9_+*%<>-]*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.terrane" },
        "2": { "name": "entity.name.type.annotation.terrane" }
      }
    },
    "keywords": {
      "name": "keyword.control.terrane",
      "match": "(?<![A-Za-z0-9_+*%<>-])(?:a|and|as|async|await|break|case|catch|class|constant|construct|continue|destruct|else|extends|finally|for|from|function|global|goto|if|implements|import|in|instance|interface|is|label|match|move|mutable|namespace|not|of|or|private|protected|public|ref|return|rust|select|self|shared|static|switch|this|throw|throws|to|trait|try|unsafe|use|uses|when|while|with|yield)(?![A-Za-z0-9_+*%<>-])"
    },
    "literals": {
      "name": "constant.language.terrane",
      "match": "(?<![A-Za-z0-9_+*%<>-])(?:true|false|none)(?![A-Za-z0-9_+*%<>-])"
    },
    "contextual-keywords": {
      "patterns": [
        {
          "name": "keyword.control.terrane",
          "match": "(?<![A-Za-z0-9_+*%<>-])(?:consuming(?=[ \\t]+(?:async[ \\t]+)?function\\b)|owning(?=[ \\t]+interface\\b)|enum(?=[ \\t]+[A-Za-z_]))(?![A-Za-z0-9_+*%<>-])"
        },
        {
          "match": "(?<![A-Za-z0-9_+*%<>-])(associated)([ \\t]+)(type)(?![A-Za-z0-9_+*%<>-])",
          "captures": {
            "1": { "name": "keyword.control.terrane" },
            "3": { "name": "keyword.control.terrane" }
          }
        }
      ]
    },
    "interpolation-key": {
      "patterns": [
        {
          "match": "(?<=\\s)(!:)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:[+*%<>-]+[A-Za-z0-9_]+)*)",
          "captures": {
            "1": { "name": "keyword.operator.terrane" },
            "3": { "name": "variable.other.interpolation-key.terrane" }
          }
        }
      ]
    },
    "lexical-tokens": {
      "comment": "Consume unscoped lexemes so later regex searches cannot begin inside joined names or split an increment/decrement token.",
      "patterns": [
        { "match": "[A-Za-z_][A-Za-z0-9_]*(?:[+*%<>-]+[A-Za-z0-9_]+)*" },
        { "match": "\\+\\+|--|<<|>>|[+*/%<>=!&^~@-]=?" }
      ]
    },
    "operators": {
      "name": "keyword.operator.terrane",
      "match": "(?<![+*%<>-])(?:\\+\\+|--)(?![A-Za-z0-9_+*%<>-])|::|(?<!\\S)(?:<<|>>|==|!=|<=|>=|=>|[-+*/%<>=!&^~])(?=\\s|$)|\\|"
    }
  }
}
