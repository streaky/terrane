{
  "name": "terrane-language",
  "displayName": "Terrane Language",
  "description": "Compiler-backed language support for Terrane",
  "version": "0.0.3",
  "publisher": "terrane",
  "license": "UNLICENSED",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "onLanguage:terrane"
  ],
  "scripts": {
    "package-server": "node ./scripts/package-server.js",
    "check": "node --check extension.js && node --check scripts/package-server.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "terrane",
        "aliases": [
          "Terrane",
          "terrane"
        ],
        "extensions": [
          ".trn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "terrane",
        "scopeName": "source.terrane",
        "path": "./syntaxes/terrane.tmLanguage.json"
      },
      {
        "scopeName": "markdown.terrane.codeblock",
        "path": "./syntaxes/terrane-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.terrane": "terrane"
        }
      }
    ],
    "configuration": {
      "title": "Terrane",
      "properties": {
        "terrane.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to a Terrane language server executable. Empty uses the binary bundled with the extension."
        }
      }
    }
  }
}
