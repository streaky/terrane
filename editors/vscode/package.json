{
  "name": "terrane-language",
  "displayName": "Terrane Language",
  "description": "Compiler-backed language support for Terrane",
  "version": "0.0.16",
  "publisher": "terrane",
  "license": "UNLICENSED",
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:terrane",
    "onDebugInitialConfigurations:terrane"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "scripts": {
    "package-server": "node ./scripts/package-server.js",
    "check": "node --check extension.js && node --check debugger.js && node --check tests/debugger.integration.js && node --check rust-blocks.js && node --check rust-block-decorations.js && node --check scripts/package-server.js && npm test",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Compile-time consumer execution and debugging are disabled until workspace trust is granted.",
      "restrictedConfigurations": ["terrane.server.path", "terrane.debugger.path"]
    }
  },
  "contributes": {
    "breakpoints": [{ "language": "terrane" }],
    "debuggers": [
      {
        "type": "terrane",
        "label": "Terrane",
        "languages": ["terrane"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Terrane source file or package manifest to build and debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Program arguments, preserving spaces and Unicode.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Debuggee working directory, resolved relative to the workspace folder (or source-file directory without a workspace). Defaults to the package source root when debug provenance is available.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at native program entry before continuing to source breakpoints.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "terrane",
            "request": "launch",
            "name": "Debug Terrane",
            "program": "${file}",
            "args": [],
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Terrane: Debug source or package",
            "body": {
              "type": "terrane",
              "request": "launch",
              "name": "Debug Terrane",
              "program": "^\"\\${file}\"",
              "args": [],
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "terrane",
        "aliases": [
          "Terrane",
          "terrane"
        ],
        "extensions": [
          ".trn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "terrane",
        "scopeName": "source.terrane",
        "path": "./syntaxes/terrane.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.rust": "rust"
        }
      },
      {
        "scopeName": "markdown.terrane.codeblock",
        "path": "./syntaxes/terrane-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.terrane": "terrane",
          "meta.embedded.block.rust": "rust"
        }
      }
    ],
    "colors": [
      {
        "id": "terrane.rustBlockBackground",
        "description": "Subtle background for embedded Rust sections.",
        "defaults": {
          "dark": "#80808014",
          "light": "#80808014",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "terrane.rustBlockBorder",
        "description": "Left border separating embedded Rust sections from Terrane.",
        "defaults": {
          "dark": "#80808088",
          "light": "#80808088",
          "highContrast": "contrastBorder",
          "highContrastLight": "contrastBorder"
        }
      }
    ],
    "configuration": {
      "title": "Terrane",
      "properties": {
        "terrane.debugger.path": {
          "type": "string",
          "default": "terrane",
          "scope": "resource",
          "description": "Terrane compiler executable used for debug builds and the adapter. Bare names use PATH; relative paths resolve against the workspace folder (or source-file directory without a workspace). Requires lldb-dap."
        },
        "terrane.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to a Terrane language server executable. Empty uses the binary bundled with the extension."
        },
        "terrane.rustBlocks.decorate": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Separate embedded Rust sections with a subtle background and left border."
        }
      }
    }
  }
}
